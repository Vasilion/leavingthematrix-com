{
  "name": "ltm-book-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/handler.ts --bundle --platform=node --target=node22 --format=esm --loader:.ttf=binary --outfile=build/index.mjs --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "test": "vitest run",
    "sample:pdf": "esbuild scripts/sample-pdf.ts --bundle --platform=node --target=node22 --format=esm --loader:.ttf=binary --outfile=build/sample-pdf.mjs && node build/sample-pdf.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1147.0",
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/client-sesv2": "^3.1147.0",
    "@aws-sdk/lib-dynamodb": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "decimal.js": "^10.6.0",
    "pdf-lib": "^1.17.1",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
