---
// Hero video: services overview on YouTube. Using youtube-nocookie embed
// for privacy mode (doesn't drop tracking cookies until playback starts)
// and lazy loading so the iframe doesn't block first paint above the fold
// on mobile.
const YOUTUBE_VIDEO_ID = 'yBiS8hJzGbs';
---

<section class="relative isolate overflow-hidden bg-black">
  <!-- Atmospheric backdrop only -->
  <div class="absolute inset-0 -z-10">
    <div class="absolute inset-0 bg-gradient-to-b from-black via-ink-900/80 to-black"></div>
    <div class="absolute inset-0 bg-grid-faint bg-grid opacity-25"></div>
    <div class="scanlines absolute inset-0 opacity-60"></div>
  </div>

  <div class="container-wide pt-12 pb-20 md:pt-24 md:pb-28">
    <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-16">
      <!-- Text column — appears FIRST on mobile so the value prop is above the fold -->
      <div class="order-1 lg:order-1 lg:col-span-5">
        <p class="eyebrow">↳ Investing education · Smart-money signals · Community</p>

        <h1 class="mt-6 font-display text-display-lg uppercase leading-[0.95] tracking-tight text-bone">
          Quality businesses.<br />
          Smart-money flow.<br />
          <span class="text-gradient-signal">Real research.</span>
        </h1>

        <p class="mt-8 text-lg text-bone-dim">
          We teach the institutional research framework — quality, valuation discount, and
          smart-money confirmation — and surface every name our desk is watching. Education
          you can apply, signals you can follow, a community that takes the work seriously.
        </p>

        <p class="mt-3 text-sm text-bone-mute">
          Educational content only — never personalized financial advice.
        </p>

        <div class="mt-10 flex flex-wrap items-center gap-4">
          <a href="/membership" class="btn-primary">
            Leave the Matrix
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a href="/membership" class="btn-secondary">See what's inside</a>
        </div>
      </div>

      <!-- Video column — services overview. Second on mobile, right side on desktop -->
      <div class="order-2 lg:order-2 lg:col-span-7">
        <div class="relative">
          <!-- Soft radial glow behind the video -->
          <div
            class="pointer-events-none absolute -inset-12 -z-10 bg-signal/[0.08] blur-[80px]"
            aria-hidden="true"
          ></div>
          <div class="relative aspect-video w-full overflow-hidden rounded-lg border border-bone/10 bg-black shadow-2xl shadow-signal/10">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${YOUTUBE_VIDEO_ID}?rel=0&modestbranding=1`}
              title="Leaving The Matrix — services overview"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
              class="absolute inset-0 h-full w-full"
            ></iframe>
          </div>
        </div>
      </div>
    </div>

    <!-- Stats strip -->
    <dl class="mt-16 grid grid-cols-1 gap-px overflow-hidden rounded-lg border border-bone/10 bg-bone/10 sm:grid-cols-3 md:mt-24">
      <div class="bg-ink-900 px-6 py-5">
        <dt class="eyebrow">Framework</dt>
        <dd class="mt-2 font-display text-xl uppercase tracking-tight text-bone">
          Quality · Discount · Smart-money
        </dd>
      </div>
      <div class="bg-ink-900 px-6 py-5">
        <dt class="eyebrow">Coverage</dt>
        <dd class="mt-2 font-display text-xl uppercase tracking-tight text-bone">
          Stocks · ETFs · Options · Crypto
        </dd>
      </div>
      <div class="bg-ink-900 px-6 py-5">
        <dt class="eyebrow">Discipline</dt>
        <dd class="mt-2 font-display text-xl uppercase tracking-tight text-bone">
          Long-term · Debt-aware · Planned
        </dd>
      </div>
    </dl>
  </div>
</section>
