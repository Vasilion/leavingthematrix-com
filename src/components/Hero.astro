---
import { Image } from 'astro:assets';
import banner from '../assets/banner.png';
import { SITE } from '../lib/site';
---

<section class="relative isolate overflow-hidden">
  <!-- Atmospheric backdrop only — no banner here -->
  <div class="absolute inset-0 -z-10">
    <div class="absolute inset-0 bg-gradient-to-b from-black via-ink-900 to-black"></div>
    <div class="absolute inset-0 bg-grid-faint bg-grid opacity-40"></div>
    <div class="scanlines absolute inset-0"></div>
    <div
      class="absolute left-1/2 top-1/3 -z-10 h-[680px] w-[1100px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-signal/10 blur-[140px]"
    ></div>
  </div>

  <div class="container-wide pt-16 pb-24 md:pt-20 md:pb-28">
    <p class="eyebrow text-center">↳ Investing education · Signals · Community</p>

    <!-- Banner displayed at native aspect ratio, contained, never upscaled -->
    <div class="mx-auto mt-8 max-w-5xl">
      <div class="relative">
        <div
          class="pointer-events-none absolute -inset-2 rounded-2xl bg-gradient-to-br from-signal/20 via-transparent to-pulse/20 blur-2xl"
          aria-hidden="true"
        ></div>
        <div class="relative overflow-hidden rounded-2xl border border-bone/10 bg-black shadow-signal-soft">
          <Image
            src={banner}
            alt="Leaving The Matrix"
            widths={[640, 960, 1248]}
            sizes="(max-width: 1024px) 95vw, 1100px"
            class="h-auto w-full"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>

    <!-- Tagline + CTAs below the banner -->
    <div class="mx-auto mt-14 max-w-3xl text-center">
      <p class="font-display text-display-md uppercase tracking-tight text-bone">
        Quality businesses. Smart-money flow.<br class="hidden sm:block" />
        <span class="text-signal">Real research.</span>
      </p>
      <p class="mt-6 text-lg text-bone-dim md:text-xl">
        The institutional framework — quality, valuation discount, and smart-money confirmation —
        applied to retail accounts. Education that goes deep. Signals grounded in data.
      </p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a href={SITE.discord.subscribe} target="_blank" rel="noopener" class="btn-primary">
          Join the Discord
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
        <a href="/membership" class="btn-secondary">See what's inside</a>
      </div>
    </div>

    <!-- Stats strip -->
    <dl class="mx-auto mt-20 grid max-w-4xl grid-cols-1 gap-8 text-center sm:grid-cols-3">
      <div class="border-t border-bone/10 pt-6 sm:border-l sm:border-t-0 sm:pl-6 sm:pt-0">
        <dt class="eyebrow">Framework</dt>
        <dd class="mt-3 font-display text-2xl uppercase tracking-tight text-bone">
          Quality · Discount · Smart-money
        </dd>
      </div>
      <div class="border-t border-bone/10 pt-6 sm:border-l sm:border-t-0 sm:pl-6 sm:pt-0">
        <dt class="eyebrow">Coverage</dt>
        <dd class="mt-3 font-display text-2xl uppercase tracking-tight text-bone">
          Stocks · ETFs · Options · Crypto
        </dd>
      </div>
      <div class="border-t border-bone/10 pt-6 sm:border-l sm:border-t-0 sm:pl-6 sm:pt-0">
        <dt class="eyebrow">Channel</dt>
        <dd class="mt-3 font-display text-2xl uppercase tracking-tight text-bone">
          Discord · Live
        </dd>
      </div>
    </dl>
  </div>
</section>
