---
import { Image } from 'astro:assets';
import banner from '../assets/banner.png';
import { SITE } from '../lib/site';
---

<section class="relative isolate overflow-hidden bg-black">
  <!-- Atmospheric backdrop only -->
  <div class="absolute inset-0 -z-10">
    <div class="absolute inset-0 bg-gradient-to-b from-black via-ink-900/80 to-black"></div>
    <div class="absolute inset-0 bg-grid-faint bg-grid opacity-25"></div>
    <div class="scanlines absolute inset-0 opacity-60"></div>
  </div>

  <div class="container-wide pt-20 pb-24 md:pt-24 md:pb-28">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <!-- Banner column (visual mark) -->
      <div class="order-1 lg:order-2 lg:col-span-7">
        <div class="relative">
          <!-- Soft radial glow behind the banner -->
          <div
            class="pointer-events-none absolute -inset-12 -z-10 bg-signal/[0.08] blur-[80px]"
            aria-hidden="true"
          ></div>
          <Image
            src={banner}
            alt="Leaving The Matrix"
            widths={[480, 720, 960, 1248]}
            sizes="(max-width: 1024px) 95vw, 720px"
            class="h-auto w-full"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>

      <!-- Text column (the message) -->
      <div class="order-2 lg:order-1 lg:col-span-5">
        <p class="eyebrow">↳ Investing education · Signals · Community</p>

        <h1 class="mt-6 font-display text-display-lg uppercase leading-[0.95] tracking-tight text-bone">
          Quality businesses.<br />
          Smart-money flow.<br />
          <span class="text-gradient-signal">Real research.</span>
        </h1>

        <p class="mt-8 text-lg text-bone-dim">
          The institutional framework — quality, valuation discount, and smart-money
          confirmation — applied to retail accounts. Education that goes deep.
          Signals grounded in data.
        </p>

        <div class="mt-10 flex flex-wrap items-center gap-4">
          <a href={SITE.discord.subscribe} target="_blank" rel="noopener" class="btn-primary">
            Join the Discord
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a href="/membership" class="btn-secondary">See what's inside</a>
        </div>
      </div>
    </div>

    <!-- Stats strip -->
    <dl class="mt-20 grid grid-cols-1 gap-px overflow-hidden rounded-lg border border-bone/10 bg-bone/10 sm:grid-cols-3 md:mt-24">
      <div class="bg-ink-900 px-6 py-5">
        <dt class="eyebrow">Framework</dt>
        <dd class="mt-2 font-display text-xl uppercase tracking-tight text-bone">
          Quality · Discount · Smart-money
        </dd>
      </div>
      <div class="bg-ink-900 px-6 py-5">
        <dt class="eyebrow">Coverage</dt>
        <dd class="mt-2 font-display text-xl uppercase tracking-tight text-bone">
          Stocks · ETFs · Options · Crypto
        </dd>
      </div>
      <div class="bg-ink-900 px-6 py-5">
        <dt class="eyebrow">Channel</dt>
        <dd class="mt-2 font-display text-xl uppercase tracking-tight text-bone">
          Discord · Live
        </dd>
      </div>
    </dl>
  </div>
</section>
