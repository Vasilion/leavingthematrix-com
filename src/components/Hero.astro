---
// Hero right column: what a member actually does in week one (replaced the
// old services video, 2026-10-28). Steps mirror Stage 1 of My Path in the
// members area (apps/web/lib/member/path.ts in the NOVA repo).
interface WeekOneStep {
  title: string;
  detail: string;
}

const weekOne: WeekOneStep[] = [
  { title: 'Read the order of operations', detail: 'Emergency fund, the match, high interest debt, then investing.' },
  { title: 'Build your Money Plan', detail: 'About 15 questions. Free, even if you never join.' },
  { title: 'Write it into My Plan', detail: 'Budget, runway, a safety net with a date, debt order, a goal number.' },
  { title: 'Pick your 30 day checklist', detail: 'A short list of things you will actually do this month.' },
  { title: 'Say hi in the Discord', detail: 'Ask anything. Nobody minds a beginner question.' },
];
---

<section class="relative isolate overflow-hidden bg-black">
  <!-- Atmospheric backdrop only -->
  <div class="absolute inset-0 -z-10">
    <div class="absolute inset-0 bg-gradient-to-b from-black via-ink-900/80 to-black"></div>
    <div class="absolute inset-0 bg-grid-faint bg-grid opacity-25"></div>
    <div class="scanlines absolute inset-0 opacity-60"></div>
  </div>

  <div class="container-wide pt-12 pb-20 md:pt-24 md:pb-28">
    <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-16">
      <!-- Text column — appears FIRST on mobile so the value prop is above the fold -->
      <div class="order-1 lg:order-1 lg:col-span-5">
        <p class="eyebrow">↳ Money plan · Investing basics · Community</p>

        <h1 class="mt-6 font-display text-display-lg uppercase leading-[0.95] tracking-tight text-bone">
          Write the plan.<br />
          Learn the basics.<br />
          <span class="text-gradient-signal">Stop guessing.</span>
        </h1>

        <p class="mt-8 text-lg text-bone-dim">
          A membership for getting your money in order and learning to invest, one step at
          a time. You write your own plan, follow a 12 week path from budgeting to investing
          basics to selling options, and ask questions in a Discord full of people working
          on the same thing.
        </p>

        <p class="mt-4 text-lg text-bone-dim">
          After 3 months, the goal is simple: you have a written plan, you understand investing
          basics, and you're beginning to understand swing trading and selling options, with a
          community learning the same work.
        </p>

        <p class="mt-3 text-sm text-bone-mute">
          Educational content only. Never personalized financial advice.
        </p>

        <div class="mt-10 flex flex-wrap items-center gap-4">
          <a href="/tools/money-plan" class="btn-primary">
            Build my plan, free
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a href="/thesis" class="btn-secondary">Read the free weekly email</a>
        </div>
        <p class="mt-4 text-sm text-bone-mute">
          Membership is below, after the free tools. No account needed for the free tools.
        </p>
      </div>

      <!-- Week one: what a member does first. Second on mobile, right side on desktop -->
      <div class="order-2 lg:order-2 lg:col-span-7">
        <div class="relative">
          <div
            class="pointer-events-none absolute -inset-12 -z-10 bg-signal/[0.08] blur-[80px]"
            aria-hidden="true"
          ></div>
          <div class="relative rounded-lg border border-bone/10 bg-ink-900/90 p-6 shadow-2xl shadow-signal/10 sm:p-8">
            <p class="eyebrow text-signal">What week one looks like</p>
            <ol class="mt-6 space-y-5">
              {weekOne.map((step, i) => (
                <li class="flex gap-4">
                  <span class="flex h-7 w-7 flex-none items-center justify-center rounded-full border border-signal/40 font-mono text-xs text-signal">
                    {i + 1}
                  </span>
                  <div>
                    <p class="font-display text-lg uppercase tracking-tight text-bone">{step.title}</p>
                    <p class="mt-1 text-sm text-bone-dim">{step.detail}</p>
                  </div>
                </li>
              ))}
            </ol>
            <p class="mt-6 border-t border-bone/10 pt-4 text-sm text-bone-mute">
              Then eleven more weeks: investing basics, then swing trading and selling
              options, on paper first.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Stats strip -->
    <dl class="mt-16 grid grid-cols-1 gap-px overflow-hidden rounded-lg border border-bone/10 bg-bone/10 sm:grid-cols-3 md:mt-24">
      <div class="bg-ink-900 px-6 py-5">
        <dt class="eyebrow">Weeks 1 to 4 · Plan</dt>
        <dd class="mt-2 font-display text-xl uppercase tracking-tight text-bone">
          Budget · Runway · Debt order
        </dd>
      </div>
      <div class="bg-ink-900 px-6 py-5">
        <dt class="eyebrow">Weeks 5 to 8 · Invest</dt>
        <dd class="mt-2 font-display text-xl uppercase tracking-tight text-bone">
          Automate · Core · Size
        </dd>
      </div>
      <div class="bg-ink-900 px-6 py-5">
        <dt class="eyebrow">Weeks 9 to 12 · Options</dt>
        <dd class="mt-2 font-display text-xl uppercase tracking-tight text-bone">
          Puts · Calls · The wheel
        </dd>
      </div>
    </dl>
  </div>
</section>
