---
import { Image } from 'astro:assets';
import banner from '../assets/banner.png';
import { SITE } from '../lib/site';
---

<section class="relative isolate overflow-hidden bg-black">
  <!-- Banner as full-bleed background, capped so it never upscales past ~12% over native -->
  <div class="absolute inset-0 -z-10">
    <div class="relative mx-auto h-full w-full max-w-[1400px]">
      <Image
        src={banner}
        alt=""
        widths={[640, 960, 1248, 1400]}
        sizes="(max-width: 1400px) 100vw, 1400px"
        class="h-full w-full object-cover object-center"
        loading="eager"
        fetchpriority="high"
      />
      <!-- Edge fades so the bounded banner blends into the surrounding black -->
      <div class="absolute inset-y-0 -left-32 w-32 bg-gradient-to-r from-black to-transparent"></div>
      <div class="absolute inset-y-0 -right-32 w-32 bg-gradient-to-l from-black to-transparent"></div>
    </div>
    <!-- Atmospheric overlay for text contrast — focused, not muddy -->
    <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/30 to-black"></div>
    <div class="absolute inset-0 bg-grid-faint bg-grid opacity-25"></div>
    <div class="scanlines absolute inset-0"></div>
  </div>

  <div class="container-wide relative pt-20 pb-28 md:pt-28 md:pb-36">
    <p class="eyebrow text-center md:text-left">↳ Investing education · Signals · Community</p>

    <div class="mx-auto mt-8 max-w-3xl text-center md:mx-0 md:text-left">
      <h1 class="font-display text-display-xl uppercase tracking-tight text-bone [text-shadow:_0_2px_24px_rgba(0,0,0,0.85)]">
        Quality businesses.<br />
        Smart-money flow.<br />
        <span class="text-gradient-signal">Real research.</span>
      </h1>
      <p class="mt-8 max-w-2xl text-lg text-bone [text-shadow:_0_1px_8px_rgba(0,0,0,0.85)] md:text-xl md:mx-0 mx-auto">
        The institutional framework — quality, valuation discount, and smart-money confirmation —
        applied to retail accounts. Education that goes deep. Signals grounded in data.
      </p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-4 md:justify-start">
        <a href={SITE.discord.subscribe} target="_blank" rel="noopener" class="btn-primary">
          Join the Discord
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
        <a href="/membership" class="btn-secondary backdrop-blur-sm">See what's inside</a>
      </div>
    </div>

    <!-- Stats strip -->
    <dl class="mt-24 grid max-w-5xl grid-cols-1 gap-8 sm:grid-cols-3">
      <div class="border-l border-signal/30 bg-black/40 px-5 py-4 backdrop-blur-sm">
        <dt class="eyebrow">Framework</dt>
        <dd class="mt-2 font-display text-xl uppercase tracking-tight text-bone">
          Quality · Discount · Smart-money
        </dd>
      </div>
      <div class="border-l border-signal/30 bg-black/40 px-5 py-4 backdrop-blur-sm">
        <dt class="eyebrow">Coverage</dt>
        <dd class="mt-2 font-display text-xl uppercase tracking-tight text-bone">
          Stocks · ETFs · Options · Crypto
        </dd>
      </div>
      <div class="border-l border-signal/30 bg-black/40 px-5 py-4 backdrop-blur-sm">
        <dt class="eyebrow">Channel</dt>
        <dd class="mt-2 font-display text-xl uppercase tracking-tight text-bone">
          Discord · Live
        </dd>
      </div>
    </dl>
  </div>
</section>
