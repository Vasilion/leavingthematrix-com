---
import NewsletterSignup from './NewsletterSignup.astro';

interface Props {
  name: string;
  price: string;
  period: string;
  /** When set alongside annualHref, renders a Monthly/Annual toggle on the card. */
  annualPrice?: string;
  annualPeriod?: string;
  annualHref?: string;
  /** Optional savings label rendered next to the Annual toggle button (e.g. "Save $289"). */
  annualSavingsLabel?: string;
  tagline: string;
  features: readonly string[];
  cta: string;
  popular?: boolean;
  /** CTA destination. Defaults to /membership. When Stripe is wired, point each tier at its checkout. */
  href?: string;
  external?: boolean;
  /**
   * Renders the CTA as a disabled "Coming Soon" button instead of a clickable
   * link. Flip to false (or remove) once the Stripe + Discord-role-bot ships.
   */
  comingSoon?: boolean;
  /**
   * Renders an inline email-input form ("Free Your Mind" newsletter capture)
   * instead of a CTA button. Used by the Blue Pill tier — it's a free
   * newsletter signup, not a paid checkout flow.
   */
  newsletterSignup?: boolean;
  /** Tier name for analytics on the newsletter form, e.g. "membership-blue-pill". */
  newsletterSource?: string;
  /**
   * When set, the card swaps its CTA to a "Go to Members Area" link if the
   * visitor is already signed in (cross-subdomain auth-state mirror in Nav.astro
   * toggles [data-auth-when] children). The Monthly/Annual toggle hides too —
   * a signed-in member already chose. Original CTA + toggle still render for
   * signed-out visitors.
   */
  membersHref?: string;
}

const {
  name,
  price,
  period,
  annualPrice,
  annualPeriod,
  annualHref,
  annualSavingsLabel,
  tagline,
  features,
  cta,
  popular = false,
  href = '/membership',
  external = false,
  comingSoon = false,
  newsletterSignup = false,
  newsletterSource,
  membersHref,
} = Astro.props;

const hasAnnualToggle = Boolean(annualPrice && annualPeriod && annualHref);
const tierKey = name.toLowerCase().replace(/<[^>]+>/g, '').replace(/\s+/g, '-');

const ctaTarget = external ? '_blank' : undefined;
const ctaRel = ctaTarget === '_blank' ? 'noopener' : undefined;
---

<article
  class:list={[
    'relative flex flex-col rounded-2xl border p-8 transition-all',
    popular
      ? 'border-signal/60 bg-ink-800 shadow-signal-glow'
      : 'border-bone/10 bg-ink-800/60',
  ]}
  data-auth-state={membersHref ? 'signed-out' : undefined}
>
  {popular && (
    <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-signal px-4 py-1 text-xs font-bold uppercase tracking-widest text-black">
      Most Popular
    </span>
  )}

  <header>
    {/* Name comes in as HTML so we can color "Blue"/"Red" inside "Blue Pill"
        / "Red Pill" tier names. set:html preserves the inline span. */}
    <h3 class="font-display text-3xl uppercase tracking-tight text-bone" set:html={name}></h3>
    <p class="mt-2 text-sm text-bone-dim">{tagline}</p>

    {hasAnnualToggle && (
      <div
        class="mt-5 inline-flex items-center gap-1 rounded-full border border-bone/15 bg-ink-700/60 p-1 text-[11px] font-mono uppercase tracking-[0.14em]"
        data-billing-toggle={tierKey}
        data-auth-when={membersHref ? 'signed-out' : undefined}
        role="tablist"
        aria-label="Billing period"
      >
        <button
          type="button"
          role="tab"
          aria-selected="true"
          data-billing-period="monthly"
          class="rounded-full bg-signal px-3 py-1 text-black"
        >
          Monthly
        </button>
        <button
          type="button"
          role="tab"
          aria-selected="false"
          data-billing-period="annual"
          class="rounded-full px-3 py-1 text-bone-dim transition-colors hover:text-bone"
        >
          Annual
          {annualSavingsLabel && (
            <span
              data-savings-badge
              class="ml-1.5 rounded-sm bg-signal/15 px-1 py-0.5 text-[9px] tracking-[0.1em] text-signal"
            >
              {annualSavingsLabel}
            </span>
          )}
        </button>
      </div>
    )}

    <div class="mt-6 flex items-baseline gap-1">
      <span
        class="font-display text-5xl text-bone"
        data-tier-price={tierKey}
        data-monthly-price={price}
        data-annual-price={annualPrice}
      >{price}</span>
      <span
        class="text-sm text-bone-mute"
        data-tier-period={tierKey}
        data-monthly-period={period}
        data-annual-period={annualPeriod}
      >{period}</span>
    </div>
  </header>

  <ul class="mt-8 space-y-3 text-sm text-bone-dim">
    {features.map((feature) => (
      <li class="flex items-start gap-3">
        <svg class="mt-0.5 h-4 w-4 flex-none text-signal" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
        </svg>
        <span>{feature}</span>
      </li>
    ))}
  </ul>

  <div class="mt-10 flex-1"></div>

  {newsletterSignup ? (
    <NewsletterSignup
      source={newsletterSource ?? `tier-${name.toLowerCase().replace(/\s+/g, '-')}`}
      id={`tier-signup-${name.toLowerCase().replace(/\s+/g, '-')}`}
    />
  ) : comingSoon ? (
    <button
      type="button"
      disabled
      aria-disabled="true"
      class="mt-6 inline-flex w-full cursor-not-allowed items-center justify-center gap-2 rounded-md border border-bone/15 bg-ink-700/50 px-5 py-3 text-sm font-bold uppercase tracking-wider text-bone-mute/70"
    >
      Coming Soon
    </button>
  ) : (
    <>
      <a
        href={href}
        target={ctaTarget}
        rel={ctaRel}
        data-tier-cta={tierKey}
        data-monthly-href={href}
        data-annual-href={annualHref}
        data-auth-when={membersHref ? 'signed-out' : undefined}
        class:list={['mt-6', popular ? 'btn-primary w-full' : 'btn-secondary w-full']}
      >
        {cta}
      </a>
      {membersHref && (
        <a
          href={membersHref}
          data-auth-when="signed-in"
          style="display: none;"
          class:list={['mt-6', popular ? 'btn-primary w-full' : 'btn-secondary w-full']}
        >
          Go to Members Area
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      )}
    </>
  )}
</article>

{hasAnnualToggle && (
  <script define:vars={{ tierKey }}>
    const toggle = document.querySelector(`[data-billing-toggle="${tierKey}"]`);
    if (toggle) {
      const buttons = toggle.querySelectorAll('[data-billing-period]');
      const priceEl = document.querySelector(`[data-tier-price="${tierKey}"]`);
      const periodEl = document.querySelector(`[data-tier-period="${tierKey}"]`);
      const ctaEl = document.querySelector(`[data-tier-cta="${tierKey}"]`);

      const setPeriod = (period) => {
        const isAnnual = period === 'annual';

        buttons.forEach((b) => {
          const isMatch = b.dataset.billingPeriod === period;
          b.setAttribute('aria-selected', String(isMatch));
          if (isMatch) {
            b.classList.add('bg-signal', 'text-black');
            b.classList.remove('text-bone-dim', 'hover:text-bone');
          } else {
            b.classList.remove('bg-signal', 'text-black');
            b.classList.add('text-bone-dim', 'hover:text-bone');
          }
        });

        // Savings badge is a "switch and save" hint; redundant + unreadable
        // (signal-on-signal) once Annual is the active selection. Hide while
        // Annual is on, restore when user flips back to Monthly.
        const savingsBadge = toggle.querySelector('[data-savings-badge]');
        if (savingsBadge) {
          savingsBadge.style.display = isAnnual ? 'none' : '';
        }

        if (priceEl) {
          priceEl.textContent = isAnnual ? priceEl.dataset.annualPrice : priceEl.dataset.monthlyPrice;
        }
        if (periodEl) {
          periodEl.textContent = isAnnual ? periodEl.dataset.annualPeriod : periodEl.dataset.monthlyPeriod;
        }
        if (ctaEl) {
          const next = isAnnual ? ctaEl.dataset.annualHref : ctaEl.dataset.monthlyHref;
          if (next) ctaEl.setAttribute('href', next);
        }
      };

      buttons.forEach((b) => {
        b.addEventListener('click', () => setPeriod(b.dataset.billingPeriod));
      });
    }
  </script>
)}
