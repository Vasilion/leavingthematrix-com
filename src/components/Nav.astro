---
import { Image } from 'astro:assets';
import { NAV_LINKS, SITE } from '../lib/site';
import logo from '../assets/logo.png';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="sticky top-0 z-40 border-b border-bone/5 bg-black/80 backdrop-blur-md">
  <div class="container-wide flex h-16 items-center justify-between">
    <a href="/" class="flex items-center gap-3" aria-label={SITE.name}>
      <Image
        src={logo}
        alt={SITE.name}
        widths={[140, 280]}
        sizes="140px"
        class="h-9 w-auto"
        loading="eager"
      />
      <span class="sr-only">{SITE.name}</span>
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Primary">
      {NAV_LINKS.map((link) => (
        <a
          href={link.href}
          class:list={[
            'text-sm font-medium tracking-wide transition-colors',
            isActive(link.href) ? 'text-signal' : 'text-bone-dim hover:text-bone',
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="hidden md:block">
      <a href={SITE.discord.subscribe} target="_blank" rel="noopener" class="btn-primary">
        Join the Discord
      </a>
    </div>

    <button
      id="mobile-menu-toggle"
      class="md:hidden text-bone p-2 -mr-2"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-bone/5 bg-black md:hidden">
    <nav class="container-wide flex flex-col gap-1 py-4" aria-label="Mobile">
      {NAV_LINKS.map((link) => (
        <a
          href={link.href}
          class:list={[
            'rounded-md px-3 py-3 text-base font-medium transition-colors',
            isActive(link.href) ? 'text-signal bg-signal/5' : 'text-bone-dim hover:text-bone hover:bg-ink-700',
          ]}
        >
          {link.label}
        </a>
      ))}
      <a
        href={SITE.discord.subscribe}
        target="_blank"
        rel="noopener"
        class="btn-primary mt-2 w-full"
      >
        Join the Discord
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    menu?.classList.toggle('hidden');
  });
</script>
