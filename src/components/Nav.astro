---
import { Image } from 'astro:assets';
import { NAV_LINKS, SITE } from '../lib/site';
import logo from '../assets/logo.png';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="sticky top-0 z-40 border-b border-bone/10 bg-black/85 backdrop-blur-lg">
  <!-- Subtle cyan accent bar at very top -->
  <div class="h-px w-full bg-gradient-to-r from-transparent via-signal/40 to-transparent"></div>

  <div class="container-wide flex h-20 items-center justify-between gap-6 md:h-24">
    <a href="/" class="group flex items-center gap-3" aria-label={SITE.name}>
      <Image
        src={logo}
        alt={SITE.name}
        widths={[200, 320, 480]}
        sizes="(max-width: 768px) 160px, 200px"
        class="h-12 w-auto transition-transform duration-300 group-hover:scale-[1.03] md:h-14"
        loading="eager"
      />
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {NAV_LINKS.map((link) => {
        const isComingSoon = 'comingSoon' in link && link.comingSoon;
        if (isComingSoon) {
          return (
            <span
              aria-disabled="true"
              title="Coming soon"
              class="group relative cursor-not-allowed px-4 py-2 text-sm font-medium uppercase tracking-wider text-bone-mute/60"
            >
              <span>{link.label}</span>
              <span class="ml-2 rounded-sm bg-bone/10 px-1.5 py-0.5 text-[9px] font-bold tracking-widest text-bone-dim">
                SOON
              </span>
            </span>
          );
        }
        return (
          <a
            href={link.href}
            target={'external' in link && link.external ? '_blank' : undefined}
            rel={'external' in link && link.external ? 'noopener noreferrer' : undefined}
            class:list={[
              'group relative px-4 py-2 text-sm font-medium uppercase tracking-wider transition-colors',
              isActive(link.href) ? 'text-signal' : 'text-bone-dim hover:text-bone',
            ]}
          >
            <span>{link.label}{'external' in link && link.external ? ' ↗' : ''}</span>
            <span
              class:list={[
                'absolute inset-x-4 -bottom-px h-px origin-center scale-x-0 bg-signal transition-transform duration-300',
                isActive(link.href) ? 'scale-x-100' : 'group-hover:scale-x-100',
              ]}
              aria-hidden="true"
            ></span>
          </a>
        );
      })}
    </nav>

    <div class="hidden md:flex md:items-center md:gap-3">
      <a
        href="/membership"
        class="group relative inline-flex items-center gap-2 rounded-md bg-signal px-5 py-2.5 text-sm font-bold uppercase tracking-wider text-black transition-all duration-200 hover:-translate-y-0.5 hover:shadow-signal-glow active:translate-y-0"
      >
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-black/60"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-black"></span>
        </span>
        Leave the Matrix
        <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <button
      id="mobile-menu-toggle"
      class="-mr-2 inline-flex h-12 w-12 items-center justify-center rounded-md text-bone hover:bg-ink-700 md:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="hamburger h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7h16M4 12h16M4 17h16" />
      </svg>
      <svg class="close hidden h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile menu — fullscreen overlay. Display controlled via inline style
       so JS-driven open/close beats any class-level display rules. The
       `md:!hidden` class keeps it hidden on desktop with !important. -->
  <div
    id="mobile-menu"
    class="fixed inset-0 z-50 h-screen flex-col bg-black md:!hidden"
    style="display: none;"
  >
    <!-- Top bar with logo + close -->
    <div class="flex shrink-0 items-center justify-between border-b border-bone/10 bg-black px-4 py-5">
      <a href="/" class="flex items-center" aria-label={SITE.name}>
        <Image
          src={logo}
          alt={SITE.name}
          widths={[160, 240]}
          sizes="160px"
          class="h-12 w-auto"
        />
      </a>
      <button
        id="mobile-menu-close"
        class="inline-flex h-12 w-12 items-center justify-center rounded-md text-bone hover:bg-ink-700"
        aria-label="Close menu"
      >
        <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Subtle accent line -->
    <div class="h-px w-full shrink-0 bg-gradient-to-r from-transparent via-signal/40 to-transparent"></div>

    <!-- Nav links — flex-1 fills the middle, scrolls if needed -->
    <nav class="min-h-0 flex-1 overflow-y-auto bg-black px-4 py-6" aria-label="Mobile">
      <ul class="flex flex-col gap-2">
        {NAV_LINKS.map((link) => {
          const isComingSoon = 'comingSoon' in link && link.comingSoon;
          if (isComingSoon) {
            return (
              <li>
                <span
                  aria-disabled="true"
                  class="flex cursor-not-allowed items-center justify-between rounded-md px-4 py-5 text-2xl font-display uppercase tracking-wider text-bone-mute/60"
                >
                  <span>{link.label}</span>
                  <span class="rounded-sm bg-bone/10 px-2 py-1 text-[10px] font-bold tracking-widest text-bone-dim">
                    SOON
                  </span>
                </span>
              </li>
            );
          }
          return (
            <li>
              <a
                href={link.href}
                target={'external' in link && link.external ? '_blank' : undefined}
                rel={'external' in link && link.external ? 'noopener noreferrer' : undefined}
                class:list={[
                  'flex items-center justify-between rounded-md px-4 py-5 text-2xl font-display uppercase tracking-wider transition-colors',
                  isActive(link.href)
                    ? 'bg-signal/10 text-signal'
                    : 'text-bone-dim hover:bg-ink-700 hover:text-bone',
                ]}
              >
                <span>{link.label}{'external' in link && link.external ? ' ↗' : ''}</span>
                <svg class="h-5 w-5 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <!-- Bottom CTA -->
    <div class="shrink-0 border-t border-bone/10 bg-black p-4 pb-[calc(env(safe-area-inset-bottom)+1rem)]">
      <a
        href="/membership"
        class="flex w-full items-center justify-center gap-2 rounded-md bg-signal px-6 py-4 text-base font-bold uppercase tracking-wider text-black"
      >
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-black/60"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-black"></span>
        </span>
        Leave the Matrix
      </a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const closeBtn = document.getElementById('mobile-menu-close');
  const menu = document.getElementById('mobile-menu') as HTMLElement | null;
  const hamb = toggle?.querySelector('.hamburger');
  const closeIcon = toggle?.querySelector('.close');

  function openMenu() {
    toggle?.setAttribute('aria-expanded', 'true');
    if (menu) menu.style.display = 'flex';
    hamb?.classList.add('hidden');
    closeIcon?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }
  function closeMenu() {
    toggle?.setAttribute('aria-expanded', 'false');
    if (menu) menu.style.display = 'none';
    hamb?.classList.remove('hidden');
    closeIcon?.classList.add('hidden');
    document.body.style.overflow = '';
  }

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    if (expanded) closeMenu();
    else openMenu();
  });
  closeBtn?.addEventListener('click', closeMenu);

  menu?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => closeMenu());
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      closeMenu();
    }
  });
</script>
