---
import { Image } from 'astro:assets';
import { NAV_LINKS, SITE } from '../lib/site';
import logo from '../assets/logo.png';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="sticky top-0 z-40 border-b border-bone/10 bg-black/85 backdrop-blur-lg">
  <!-- Subtle cyan accent bar at very top -->
  <div class="h-px w-full bg-gradient-to-r from-transparent via-signal/40 to-transparent"></div>

  <div class="container-wide flex h-20 items-center justify-between gap-6 md:h-24">
    <a href="/" class="group flex items-center gap-3" aria-label={SITE.name}>
      <Image
        src={logo}
        alt={SITE.name}
        widths={[200, 320, 480]}
        sizes="(max-width: 768px) 160px, 200px"
        class="h-12 w-auto transition-transform duration-300 group-hover:scale-[1.03] md:h-14"
        loading="eager"
      />
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {NAV_LINKS.map((link) => {
        const isComingSoon = 'comingSoon' in link && link.comingSoon;
        if (isComingSoon) {
          return (
            <span
              aria-disabled="true"
              title="Coming soon"
              class="group relative cursor-not-allowed px-4 py-2 text-sm font-medium uppercase tracking-wider text-bone-mute/60"
            >
              <span>{link.label}</span>
              <span class="ml-2 rounded-sm bg-bone/10 px-1.5 py-0.5 text-[9px] font-bold tracking-widest text-bone-dim">
                SOON
              </span>
            </span>
          );
        }
        return (
          <a
            href={link.href}
            target={'external' in link && link.external ? '_blank' : undefined}
            rel={'external' in link && link.external ? 'noopener noreferrer' : undefined}
            class:list={[
              'group relative px-4 py-2 text-sm font-medium uppercase tracking-wider transition-colors',
              isActive(link.href) ? 'text-signal' : 'text-bone-dim hover:text-bone',
            ]}
          >
            <span>{link.label}{'external' in link && link.external ? ' ↗' : ''}</span>
            <span
              class:list={[
                'absolute inset-x-4 -bottom-px h-px origin-center scale-x-0 bg-signal transition-transform duration-300',
                isActive(link.href) ? 'scale-x-100' : 'group-hover:scale-x-100',
              ]}
              aria-hidden="true"
            ></span>
          </a>
        );
      })}
    </nav>

    <div class="hidden md:flex md:items-center md:gap-3">
      <!-- Auth: signed-out state. Phase 2 (live auth-state mirror) will toggle
           data-auth-state on the parent so signed-in users see the user pill
           below instead. Default = signed-out so the buttons render statically
           on first paint with no flicker. -->
      <div id="ltm-auth" data-auth-state="signed-out" class="flex items-center gap-3">
        <div data-auth-when="signed-out" class="flex items-center gap-3">
          <a
            href="https://nova.leavingthematrix.io/sign-in"
            class="font-mono text-[12px] uppercase tracking-[0.1em] text-bone-dim transition-colors hover:text-bone"
          >
            Sign in
          </a>
          <a
            href="https://nova.leavingthematrix.io/sign-up"
            class="inline-flex items-center rounded-md border border-signal/60 px-4 py-2 text-sm font-bold uppercase tracking-wider text-signal transition-colors hover:bg-signal/10"
          >
            Sign up
          </a>
        </div>

        <!-- Auth: signed-in state. Hidden on first paint via inline display:none
             so it doesn't flash before the auth-status fetch resolves. JS will
             flip data-auth-state="signed-in" + populate email/tier values, and
             wire the dropdown toggle. -->
        <div
          data-auth-when="signed-in"
          class="relative"
          style="display: none;"
        >
          <button
            type="button"
            id="ltm-user-toggle"
            class="flex items-center gap-2.5 rounded-full border border-bone/15 bg-ink-900/60 py-1 pl-1 pr-3 transition-colors hover:border-signal/40 hover:bg-ink-800/60"
            aria-haspopup="menu"
            aria-expanded="false"
          >
            <span data-auth-initial class="flex h-7 w-7 items-center justify-center rounded-full bg-signal text-[12px] font-semibold text-black">?</span>
            <span data-auth-tier class="rounded-md bg-signal/15 px-2 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-[0.12em] text-signal">Member</span>
            <svg width="10" height="6" viewBox="0 0 10 6" fill="none" class="text-bone-mute" aria-hidden="true">
              <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
          </button>
          <div
            id="ltm-user-menu"
            role="menu"
            class="absolute right-0 top-[calc(100%+8px)] z-50 w-64 overflow-hidden rounded-xl border border-bone/15 bg-ink-900/95 shadow-2xl shadow-signal/10 backdrop-blur-md"
            style="display: none;"
          >
            <div class="flex flex-col gap-1 border-b border-bone/10 px-4 py-3">
              <span class="font-mono text-[9px] uppercase tracking-[0.18em] text-bone-mute">Signed in as</span>
              <span data-auth-email class="truncate text-[13px] font-semibold text-bone">Member</span>
              <div class="mt-1 flex items-center gap-2">
                <span data-auth-tier-badge class="rounded-md bg-signal/15 px-2 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-[0.12em] text-signal">Member</span>
                <span class="font-mono text-[10px] text-bone-mute">tier</span>
              </div>
            </div>
            <a
              href="https://nova.leavingthematrix.io/macro"
              role="menuitem"
              class="flex w-full items-center gap-2 px-4 py-3 text-left font-mono text-[11px] uppercase tracking-[0.14em] text-bone-dim transition-colors hover:bg-ink-800 hover:text-signal"
            >
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M3 7l3 3 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Go to Members Area
            </a>
          </div>
        </div>
      </div>

      <a
        href="/membership"
        class="group relative inline-flex items-center gap-2 rounded-md bg-signal px-5 py-2.5 text-sm font-bold uppercase tracking-wider text-black transition-all duration-200 hover:-translate-y-0.5 hover:shadow-signal-glow active:translate-y-0"
      >
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-black/60"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-black"></span>
        </span>
        Leave the Matrix
        <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <button
      id="mobile-menu-toggle"
      class="-mr-2 inline-flex h-12 w-12 items-center justify-center rounded-md text-bone hover:bg-ink-700 md:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="hamburger h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7h16M4 12h16M4 17h16" />
      </svg>
      <svg class="close hidden h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile menu — fullscreen overlay. Display controlled via inline style
       so JS-driven open/close beats any class-level display rules. The
       `md:!hidden` class keeps it hidden on desktop with !important. -->
  <div
    id="mobile-menu"
    class="fixed inset-0 z-50 h-screen flex-col bg-black md:!hidden"
    style="display: none;"
  >
    <!-- Top bar with logo + close -->
    <div class="flex shrink-0 items-center justify-between border-b border-bone/10 bg-black px-4 py-5">
      <a href="/" class="flex items-center" aria-label={SITE.name}>
        <Image
          src={logo}
          alt={SITE.name}
          widths={[160, 240]}
          sizes="160px"
          class="h-12 w-auto"
        />
      </a>
      <button
        id="mobile-menu-close"
        class="inline-flex h-12 w-12 items-center justify-center rounded-md text-bone hover:bg-ink-700"
        aria-label="Close menu"
      >
        <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Subtle accent line -->
    <div class="h-px w-full shrink-0 bg-gradient-to-r from-transparent via-signal/40 to-transparent"></div>

    <!-- Nav links — flex-1 fills the middle, scrolls if needed -->
    <nav class="min-h-0 flex-1 overflow-y-auto bg-black px-4 py-6" aria-label="Mobile">
      <ul class="flex flex-col gap-2">
        {NAV_LINKS.map((link) => {
          const isComingSoon = 'comingSoon' in link && link.comingSoon;
          if (isComingSoon) {
            return (
              <li>
                <span
                  aria-disabled="true"
                  class="flex cursor-not-allowed items-center justify-between rounded-md px-4 py-5 text-2xl font-display uppercase tracking-wider text-bone-mute/60"
                >
                  <span>{link.label}</span>
                  <span class="rounded-sm bg-bone/10 px-2 py-1 text-[10px] font-bold tracking-widest text-bone-dim">
                    SOON
                  </span>
                </span>
              </li>
            );
          }
          return (
            <li>
              <a
                href={link.href}
                target={'external' in link && link.external ? '_blank' : undefined}
                rel={'external' in link && link.external ? 'noopener noreferrer' : undefined}
                class:list={[
                  'flex items-center justify-between rounded-md px-4 py-5 text-2xl font-display uppercase tracking-wider transition-colors',
                  isActive(link.href)
                    ? 'bg-signal/10 text-signal'
                    : 'text-bone-dim hover:bg-ink-700 hover:text-bone',
                ]}
              >
                <span>{link.label}{'external' in link && link.external ? ' ↗' : ''}</span>
                <svg class="h-5 w-5 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <!-- Bottom CTA -->
    <div class="shrink-0 border-t border-bone/10 bg-black p-4 pb-[calc(env(safe-area-inset-bottom)+1rem)]">
      <div id="ltm-auth-mobile" data-auth-state="signed-out" class="mb-3">
        <!-- Signed-out: Sign in + Sign up split row -->
        <div data-auth-when="signed-out" class="grid grid-cols-2 gap-3">
          <a
            href="https://nova.leavingthematrix.io/sign-in"
            class="flex items-center justify-center rounded-md border border-bone/20 px-4 py-3 text-sm font-bold uppercase tracking-wider text-bone-dim transition-colors hover:text-bone"
          >
            Sign in
          </a>
          <a
            href="https://nova.leavingthematrix.io/sign-up"
            class="flex items-center justify-center rounded-md border border-signal/60 px-4 py-3 text-sm font-bold uppercase tracking-wider text-signal transition-colors hover:bg-signal/10"
          >
            Sign up
          </a>
        </div>
        <!-- Signed-in: Members area pill -->
        <a
          data-auth-when="signed-in"
          href="https://nova.leavingthematrix.io/macro"
          class="flex w-full items-center justify-center gap-3 rounded-md border border-signal/40 bg-ink-900/60 px-4 py-3 text-sm font-bold uppercase tracking-wider text-bone transition-colors hover:bg-ink-800/60"
          style="display: none;"
        >
          <span data-auth-initial class="flex h-7 w-7 items-center justify-center rounded-full bg-signal text-[12px] font-semibold text-black">?</span>
          <span>Members Area</span>
          <span data-auth-tier class="rounded-md bg-signal/15 px-2 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-[0.12em] text-signal">Member</span>
        </a>
      </div>
      <a
        href="/membership"
        class="flex w-full items-center justify-center gap-2 rounded-md bg-signal px-6 py-4 text-base font-bold uppercase tracking-wider text-black"
      >
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-black/60"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-black"></span>
        </span>
        Leave the Matrix
      </a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const closeBtn = document.getElementById('mobile-menu-close');
  const menu = document.getElementById('mobile-menu') as HTMLElement | null;
  const hamb = toggle?.querySelector('.hamburger');
  const closeIcon = toggle?.querySelector('.close');

  function openMenu() {
    toggle?.setAttribute('aria-expanded', 'true');
    if (menu) menu.style.display = 'flex';
    hamb?.classList.add('hidden');
    closeIcon?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }
  function closeMenu() {
    toggle?.setAttribute('aria-expanded', 'false');
    if (menu) menu.style.display = 'none';
    hamb?.classList.remove('hidden');
    closeIcon?.classList.add('hidden');
    document.body.style.overflow = '';
  }

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    if (expanded) closeMenu();
    else openMenu();
  });
  closeBtn?.addEventListener('click', closeMenu);

  menu?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => closeMenu());
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      closeMenu();
    }
  });

  // ============================================================================
  // Auth-state mirror — fetch sign-in status from nova.leavingthematrix.io and
  // swap the header chrome between signed-out (Sign in / Sign up) and signed-in
  // (user pill + Members Area dropdown). Cookie is set on nova.leavingthematrix.io
  // by Clerk; same-site fetch with credentials sends it.
  // ============================================================================

  const AUTH_STATUS_URL = 'https://nova.leavingthematrix.io/api/auth-status';

  type AuthStatus = {
    signedIn: boolean;
    email?: string | null;
    tier?: 'free' | 'pro' | 'elite' | null;
  };

  function applyAuthState(status: AuthStatus) {
    const wrappers = document.querySelectorAll<HTMLElement>('[data-auth-state]');
    const state = status.signedIn ? 'signed-in' : 'signed-out';

    wrappers.forEach((wrapper) => {
      wrapper.dataset.authState = state;
      // Toggle visibility on each [data-auth-when] child via inline style so we
      // beat any class-level rules and avoid Tailwind JIT issues.
      wrapper.querySelectorAll<HTMLElement>('[data-auth-when]').forEach((el) => {
        const wantState = el.dataset.authWhen;
        const visible = wantState === state;
        // Desktop pill is inline-flex / relative; mobile is grid / flex. Reset
        // by removing inline style entirely so the class-defined display wins.
        if (visible) {
          el.style.display = '';
        } else {
          el.style.display = 'none';
        }
      });
    });

    if (status.signedIn) {
      const email = status.email ?? '';
      const tier = (status.tier ?? 'free').toUpperCase();
      const tierLabel =
        tier === 'PRO' ? 'PRO' : tier === 'ELITE' ? 'ELITE' : 'MEMBER';
      const initial = email
        ? email.charAt(0).toUpperCase()
        : 'M';

      document
        .querySelectorAll<HTMLElement>('[data-auth-initial]')
        .forEach((el) => {
          el.textContent = initial;
        });
      document
        .querySelectorAll<HTMLElement>('[data-auth-tier]')
        .forEach((el) => {
          el.textContent = tierLabel;
        });
      document
        .querySelectorAll<HTMLElement>('[data-auth-tier-badge]')
        .forEach((el) => {
          el.textContent = tierLabel;
        });
      document
        .querySelectorAll<HTMLElement>('[data-auth-email]')
        .forEach((el) => {
          el.textContent = email || 'Member';
        });
    }
  }

  // Wire the desktop user-pill dropdown. Toggle visibility on click, close on
  // outside click + Escape. (Mobile signed-in path is just a direct link; no
  // dropdown needed since the menu is already a full-screen overlay.)
  const userToggle = document.getElementById('ltm-user-toggle');
  const userMenu = document.getElementById('ltm-user-menu');
  function closeUserMenu() {
    if (userMenu) userMenu.style.display = 'none';
    userToggle?.setAttribute('aria-expanded', 'false');
  }
  function openUserMenu() {
    if (userMenu) userMenu.style.display = 'block';
    userToggle?.setAttribute('aria-expanded', 'true');
  }
  userToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    const expanded = userToggle.getAttribute('aria-expanded') === 'true';
    if (expanded) closeUserMenu();
    else openUserMenu();
  });
  document.addEventListener('click', (e) => {
    if (!userMenu || userMenu.style.display === 'none') return;
    const target = e.target as Node;
    if (userMenu.contains(target) || userToggle?.contains(target)) return;
    closeUserMenu();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeUserMenu();
  });

  // Kick off the auth-status fetch. Failures (network, CORS, Clerk down) are
  // silently treated as signed-out so the static buttons still render.
  fetch(AUTH_STATUS_URL, {
    method: 'GET',
    credentials: 'include',
    headers: { Accept: 'application/json' },
  })
    .then((res) => (res.ok ? (res.json() as Promise<AuthStatus>) : { signedIn: false }))
    .then((status) => applyAuthState(status))
    .catch(() => applyAuthState({ signedIn: false }));
</script>
