---
import PerformanceProofLive from './PerformanceProofLive.svelte';

// Live performance proof — replaces the prior stubbed line charts.
// Real numbers (TWR, annualized, vs benchmark) come from
// nova.leavingthematrix.io/api/performance/public, which projects Luke's
// latest ClickCapital scrape from Neon. Every Sync click in Nova desktop
// updates the data; the next /membership visit picks it up.
//
// Why stat cards vs line chart: ClickCapital scrapes capture lifetime
// aggregates (TWR, annualized, dollar gain/loss) but not a time series.
// Synthesizing fake monthly points to fill a chart would be dishonest.
// Real lifetime stats + same-period benchmark return is more credible
// proof and matches what serious investors actually look at.

// In dev, point at localhost:3030 so we can iterate without prod backend.
// In prod, the default endpoint hits the live Nova subdomain.
const endpoint = import.meta.env.DEV
  ? 'http://localhost:3030/api/performance/public'
  : 'https://nova.leavingthematrix.io/api/performance/public';
---

<section class="border-y border-bone/5 bg-ink-900">
  <div class="container-wide py-14 md:py-24">
    <div class="max-w-3xl">
      <p class="eyebrow">Track record</p>
      <h2 class="mt-4 font-display text-display-lg uppercase tracking-tight">
        The framework <span class="text-signal">works</span>.
      </h2>
      <p class="mt-6 text-bone-dim">
        Two of our published portfolios — ETF Momentum and Stock Picks —
        scored against the index they should be benchmarked against.
        Time-weighted returns and annualized rates pulled live from the
        portfolios; benchmark returns computed for the same period. Past
        performance does not indicate future results.
      </p>
    </div>

    <div class="mt-8 md:mt-12">
      <PerformanceProofLive client:load endpoint={endpoint} />
    </div>

    <p class="mt-10 text-center text-xs text-bone-mute">
      Educational content only. Past performance does not indicate future results.
      Trading involves substantial risk of loss.
    </p>
  </div>
</section>
