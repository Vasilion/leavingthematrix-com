---
const lanes = [
  {
    title: 'Education',
    blurb:
      'The fundamentals — DCA, set-and-forget portfolios, options mechanics, market structure. The "I never went to finance school" pipeline.',
    channels: [
      'getting-started',
      'dollar-cost-averaging',
      'set-and-forget-portfolios',
      'education',
      'misc-content',
    ],
    accent: 'from-signal/30 to-transparent',
  },
  {
    title: 'Signals',
    blurb:
      'Picks, levels, theses. Long-term high-conviction names, swing setups, dip buys, ETF momentum, passive-income strategies, and crypto.',
    channels: [
      'stock-picks-long-term',
      'buy-the-dip',
      'swing-trades',
      'longer-trades',
      'market-watch',
      'lukes-passive-income-machine',
      'crypto',
    ],
    accent: 'from-pulse/30 to-transparent',
  },
  {
    title: 'Community',
    blurb:
      'Where members share gains, share losses, and ask anything. Real positions, real conversations, no hype.',
    channels: [
      'active-trades',
      'community-chat',
      'your-gains-and-losses',
      'market-recap',
      'etf-momentum',
      'polls',
      'help',
    ],
    accent: 'from-signal/20 to-transparent',
  },
  {
    title: 'Pro Floor',
    blurb:
      'Higher-conviction research and direct access. Deep-value names trading near 200-week support, options ideas with full thesis, and 1-on-1 review.',
    channels: [
      'pro-chat',
      'options',
      '200-wma-only-deep-value',
      'stock-picks-portfolio',
    ],
    accent: 'from-pulse/40 to-transparent',
    pro: true,
  },
];
---

<section class="container-wide py-24">
  <div class="max-w-2xl">
    <p class="eyebrow">Inside the Discord</p>
    <h2 class="mt-4 font-display text-display-lg uppercase tracking-tight">
      Four floors.<br />
      <span class="text-signal">Same framework.</span>
    </h2>
    <p class="mt-6 text-lg text-bone-dim">
      Every lane runs on the same disciplined research framework. Whether you're starting with
      a Roth IRA or sizing positions like a fund manager, there's a room with your name on it.
    </p>
  </div>

  <div class="mt-16 grid gap-6 md:grid-cols-2">
    {lanes.map((lane) => (
      <div class:list={['card relative overflow-hidden', lane.pro && 'border-pulse/30']}>
        <div class:list={['absolute inset-0 -z-0 bg-gradient-to-br opacity-50', lane.accent]} />
        <div class="relative z-10">
          <div class="flex items-center justify-between">
            <h3 class="font-display text-2xl uppercase tracking-tight text-bone">{lane.title}</h3>
            {lane.pro && (
              <span class="rounded-full border border-pulse/40 bg-pulse/10 px-2 py-0.5 text-[10px] font-bold uppercase tracking-widest text-pulse">
                Pro
              </span>
            )}
          </div>
          <p class="mt-2 text-sm text-bone-dim">{lane.blurb}</p>
          <ul class="mt-6 flex flex-wrap gap-2">
            {lane.channels.map((channel) => (
              <li class="rounded-md border border-bone/10 bg-ink-700/60 px-2.5 py-1 font-mono text-xs text-bone-dim">
                #{channel}
              </li>
            ))}
          </ul>
        </div>
      </div>
    ))}
  </div>
</section>
