---
// Four parts of what's inside the membership, in the order a member meets
// them: plan, path, community, research tools (members-area v1, 2026-10-28).
// Keep the framing about what it does for the member, not the channel SKUs.
const lanes = [
  {
    title: 'Your plan',
    blurb:
      'Your money, written down in one place: a budget, how long your cash would last, a safety net with a date, the order to pay off debt, and a goal number. Reviewed every quarter.',
    items: ['Budget', 'Runway', 'Safety net', 'Debt payoff order', 'Goal number', 'Quarterly review'],
    accent: 'from-signal/30 to-transparent',
  },
  {
    title: 'Your path',
    blurb:
      'Twelve weeks, in order. The plan first, then investing basics, then the basics of swing trading and selling options, practised on paper. One lesson a week, with one company as the case study.',
    items: ['Stage 1 · Plan', 'Stage 2 · Investing basics', 'Stage 3 · Swing + selling options', 'Weekly lesson'],
    accent: 'from-pulse/30 to-transparent',
  },
  {
    title: 'Community',
    blurb:
      'The Pro role in our Discord. People working through the same path, asking questions, and sharing what they are learning. No hype.',
    items: ['Start here', 'Ask anything', 'Wins and lessons'],
    accent: 'from-signal/20 to-transparent',
  },
  {
    title: 'Research tools',
    blurb:
      'The tools we built for our own research, for when you want to go deeper. Optional. You do not need them to be a member.',
    items: ['Nova Lookup', 'Screener', 'Smart Money tab'],
    accent: 'from-pulse/40 to-transparent',
    pro: true,
  },
];
---

<section class="container-wide py-14 md:py-24">
  <div class="max-w-2xl">
    <p class="eyebrow">What's inside</p>
    <h2 class="mt-4 font-display text-display-lg uppercase tracking-tight">
      Four parts.<br />
      <span class="text-signal">One calm order.</span>
    </h2>
    <p class="mt-6 text-lg text-bone-dim">
      Write your plan, follow the path, ask the community, and use the research
      tools when you are ready. Educational only, never personalized advice.
    </p>
  </div>

  <div class="mt-10 md:mt-16 grid gap-6 md:grid-cols-2">
    {lanes.map((lane) => (
      <div class:list={['card relative overflow-hidden', lane.pro && 'border-signal/40']}>
        <div class:list={['absolute inset-0 -z-0 bg-gradient-to-br opacity-50', lane.accent]} />
        <div class="relative z-10">
          <div class="flex items-center justify-between">
            <h3 class="font-display text-2xl uppercase tracking-tight text-bone">{lane.title}</h3>
            {lane.pro && (
              <span class="rounded-full border border-signal/40 bg-signal/10 px-2 py-0.5 text-[10px] font-bold uppercase tracking-widest text-signal">
                Built by us
              </span>
            )}
          </div>
          <p class="mt-2 text-sm text-bone-dim" set:html={lane.blurb}></p>
          <ul class="mt-6 flex flex-wrap gap-2">
            {lane.items.map((item) => (
              <li class="rounded-md border border-bone/10 bg-ink-700/60 px-2.5 py-1 font-mono text-xs text-bone-dim">
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    ))}
  </div>
</section>
