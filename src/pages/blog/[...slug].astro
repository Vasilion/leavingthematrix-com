---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const canonical = new URL(`/blog/${post.slug}/`, Astro.site).toString();
const ogImage = new URL('/og-default.png', Astro.site).toString();

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.summary,
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  author: { '@type': 'Person', name: SITE.founder },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    logo: { '@type': 'ImageObject', url: new URL('/android-chrome-512x512.png', Astro.site).toString() },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  image: ogImage,
  keywords: post.data.tags.join(', '),
  articleSection: post.data.category,
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog/', Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: canonical },
  ],
};
---

<Layout
  title={post.data.title}
  description={post.data.summary}
  ogType="article"
  article={{
    publishedTime: post.data.date.toISOString(),
    modifiedTime: post.data.date.toISOString(),
    author: SITE.founder,
    section: post.data.category,
    tags: post.data.tags,
  }}
  jsonLd={[articleLd, breadcrumbLd]}
>
  <article class="container-prose py-16 md:py-24">
    <!-- Visible breadcrumb -->
    <nav class="text-xs text-bone-mute" aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href="/" class="hover:text-signal">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/blog" class="hover:text-signal">Blog</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-bone-dim" aria-current="page">{post.data.title}</li>
      </ol>
    </nav>

    <header class="mt-8 border-b border-bone/10 pb-8">
      <div class="flex flex-wrap items-center gap-4 text-xs">
        <span class="eyebrow text-pulse">{post.data.category}</span>
        <time class="font-mono text-bone-mute" datetime={post.data.date.toISOString()}>
          {post.data.date.toISOString().slice(0, 10)}
        </time>
        <span class="font-mono text-bone-mute">{post.data.readMinutes} min read</span>
      </div>
      <h1 class="mt-6 font-display text-display-md uppercase tracking-tight">
        {post.data.title}
      </h1>
      <p class="mt-4 text-lg text-bone-dim">{post.data.summary}</p>

      {post.data.tags.length > 0 && (
        <div class="mt-6 flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <span class="font-mono text-xs text-bone-mute">#{tag}</span>
          ))}
        </div>
      )}
    </header>

    <div class="prose-ltm mt-12">
      <Content />
    </div>

    <div class="mt-16 border-t border-bone/10 pt-12">
      <div class="card-interactive flex flex-col items-start gap-6 border-signal/30 p-8 md:flex-row md:items-center md:justify-between">
        <div>
          <h3 class="font-display text-2xl uppercase tracking-tight">Want this in real time?</h3>
          <p class="mt-2 text-sm text-bone-dim">Discussion happens in the Discord.</p>
        </div>
        <a href={SITE.discord.subscribe} target="_blank" rel="noopener" class="btn-primary whitespace-nowrap">
          Join the Discord
        </a>
      </div>
    </div>
  </article>
</Layout>
