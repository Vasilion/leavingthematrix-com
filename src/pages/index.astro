---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ChannelGrid from '../components/ChannelGrid.astro';
import NewsletterCallout from '../components/NewsletterCallout.astro';
import Pill from '../components/Pill.astro';
import { PRICING_TIERS } from '../lib/site';
import PricingTier from '../components/PricingTier.astro';
---

<Layout>
  <Hero />

  <ChannelGrid />

  <section class="container-wide pt-14 md:pt-24">
    <a href="/tools/money-plan" class="card-interactive flex flex-col items-start gap-4 md:flex-row md:items-center md:justify-between md:gap-10">
      <div>
        <p class="eyebrow">Free · Start here</p>
        <h2 class="mt-3 font-display text-3xl uppercase tracking-tight sm:text-4xl">The Money Plan</h2>
        <p class="mt-3 max-w-2xl text-bone-dim">
          Start here even if you never join. Answer about 15 questions and get a budget, your runway, a safety
          net and a debt payoff order, built from my book Disqualified. Free, as a PDF.
        </p>
      </div>
      <span class="btn-secondary whitespace-nowrap">Build my plan</span>
    </a>
  </section>

  <section class="container-wide py-14 md:py-24">
    <div class="max-w-2xl">
      <p class="eyebrow">Membership</p>
      <h2 class="mt-4 font-display text-4xl uppercase leading-[0.95] tracking-tight sm:text-5xl md:text-display-lg">
        Start free. <span class="text-signal">Join when it's useful.</span>
      </h2>
      <p class="mt-6 text-lg text-bone-dim">
        The free Sunday email is a good way to see how I think. <Pill color="red" />
        is the whole thing: your plan, the 12 week path, the library, a weekly
        lesson, and the community.
      </p>
    </div>

    <div class="mt-10 md:mt-16 grid gap-6 md:grid-cols-2">
      {PRICING_TIERS.map((tier) => <PricingTier {...tier} />)}
    </div>

    <p class="mt-8 text-center text-xs text-bone-mute">
      Cancel anytime. Educational content only, never personalized financial advice.
    </p>
  </section>

  <NewsletterCallout
    source="home"
    eyebrow="LTM Investing Thesis · Free every Sunday"
    headline="Not ready to join? Read along first."
    description="Every Sunday I take the stock everyone's hyping and check the math. Real numbers, bear, base and bull scenarios, and a straight read on whether it holds up. No hype, no spam."
  />

  <section class="container-wide pb-14 md:pb-24">
    <div class="card-interactive flex flex-col items-start gap-6 border-signal/30 bg-gradient-to-br from-ink-800 to-ink-900 p-12 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 class="font-display text-display-md uppercase tracking-tight">
          Start with the plan.
        </h2>
        <p class="mt-3 text-bone-dim">
          Everything else builds on it.
        </p>
      </div>
      <a href="/membership" class="btn-primary whitespace-nowrap">
        See membership
      </a>
    </div>
  </section>
</Layout>
