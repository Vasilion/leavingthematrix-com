---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import headshot from '../assets/headshot.png';
import Pill from '../components/Pill.astro';
import NewsletterCallout from '../components/NewsletterCallout.astro';

const career = [
  {
    company: 'a.i. solutions',
    role: 'Senior Space Products Frontend Engineer',
    period: 'Current',
    description:
      "Building the frontend for FreeFlyer, an astrodynamics suite powering missions for the International Space Station, James Webb Space Telescope, NASA's Artemis program, Lunar Gateway, and Dream Chaser.",
  },
  {
    company: 'State of Michigan, Senate',
    role: 'Full Stack Developer',
    period: '2022 to 2025',
    description:
      'Architected Eva from sprint zero, a legislation processing platform streamlining bills, amendments, and resolutions. Lead front-end developer on a team of ten.',
  },
  {
    company: 'Salamander Technologies',
    role: 'Software Developer',
    period: '2020 to 2022',
    description:
      'Led front-end development for Salamander LIVE, used by 1.2M+ daily users including first responders. Shipped the v66 release: 138 features, zero post-release bugs.',
  },
  {
    company: 'Allstate',
    role: 'Software Developer',
    period: '2019 to 2020',
    description:
      'Built a secure agent portal in React, replacing the legacy system to meet modern compliance requirements.',
  },
  {
    company: 'General Motors',
    role: 'Software Developer',
    period: '2017 to 2018',
    description:
      "Worked on the Next-Gen Vehicle Configurator, the Marketing Admin CMS, and GM Brazil's Shop Click Drive platform.",
  },
];

---

<Layout
  title="About"
  description="Leaving The Matrix is a membership for writing a real plan for your money and learning to invest one step at a time. Built by Luke Vasilion. Educational only."
>
  <!-- LEAD: what LTM is -->
  <section class="border-b border-bone/5">
    <div class="container-wide pt-14 pb-10 md:pt-24 md:pb-16">
      <div class="grid gap-8 md:gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-7">
          <p class="eyebrow">About Leaving The Matrix</p>
          <h1 class="mt-4 font-display text-display-xl uppercase tracking-tight">
            Get your money right.<br />
            <span class="text-signal">Then learn to invest it.</span>
          </h1>
          <p class="mt-8 text-xl text-bone-dim">
            Leaving The Matrix is a membership for people who want a real plan for
            their money and want to understand what they're buying. You write the
            plan, you learn the basics in order, and you do it next to people
            working on the same thing.
          </p>

          <div class="prose-ltm mt-10">
            <p>
              I started this because most of what's out there is one of two things.
              Somebody yelling tickers, or a course that teaches you nothing you can
              use on Monday. I didn't come from money. Nobody sat me down and
              explained a budget, let alone a cash-secured put. This is the thing I
              wish I'd had.
            </p>
            <p>
              It starts boring on purpose. A budget, your runway, a safety net with a
              date on it, the order you pay off debt, and a goal number. Then the
              investing basics: automating it, building a core, valuing a business in
              plain terms, sizing, and deciding now what you'll do the next time the
              market drops. After that, the basics of swing trading and selling
              options, on paper first.
            </p>
            <p>
              <strong>Educational content only.</strong> I'm not a financial adviser
              and I don't make personalized recommendations. I'll show you how I think
              about it. What you do with your money is your call.
            </p>
          </div>
        </div>

        <aside class="lg:col-span-5">
          <div class="sticky top-28 space-y-4">
            <div class="card border-signal/30 bg-ink-800">
              <p class="eyebrow text-signal">What members get</p>
              <ul class="mt-6 space-y-4 text-sm text-bone-dim">
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 h-1.5 w-1.5 flex-none rounded-full bg-signal" aria-hidden="true"></span>
                  <span><strong class="text-bone">My Plan.</strong> Your budget, runway, safety net, debt order and goal, written down in one place.</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 h-1.5 w-1.5 flex-none rounded-full bg-signal" aria-hidden="true"></span>
                  <span><strong class="text-bone">A 12 week path.</strong> The plan, then investing basics, then swing trading and selling options.</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 h-1.5 w-1.5 flex-none rounded-full bg-signal" aria-hidden="true"></span>
                  <span><strong class="text-bone">The library and a weekly lesson.</strong> The basics explained once, and one new idea every Sunday.</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 h-1.5 w-1.5 flex-none rounded-full bg-signal" aria-hidden="true"></span>
                  <span><strong class="text-bone">The community.</strong> The Pro role in our Discord, with research tools there when you want to go deeper.</span>
                </li>
              </ul>
            </div>

            <div class="card">
              <p class="eyebrow">The fine print</p>
              <p class="mt-3 text-sm text-bone-dim">
                Educational content only. Never personalized financial advice. I share
                how I think and what I do. You decide what fits your situation.
              </p>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- The framework -->
  <section class="border-b border-bone/5 bg-ink-900">
    <div class="container-wide py-14 md:py-24">
      <div class="grid gap-8 md:gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <p class="eyebrow">The framework</p>
          <h2 class="mt-4 font-display text-display-md uppercase tracking-tight">
            Quality.<br />
            Discount.<br />
            <span class="text-signal">Smart-money.</span>
          </h2>
          <p class="mt-6 text-bone-dim">
            This is how I look at any stock, and it's what Stage 2 of the path
            teaches. The research tools score names with the same lens.
          </p>
        </div>

        <div class="lg:col-span-7">
          <ul class="space-y-4">
            <li class="card">
              <p class="eyebrow">Quality</p>
              <h3 class="mt-2 font-display text-xl tracking-tight text-bone">Is this a good business?</h3>
              <p class="mt-2 text-sm text-bone-dim">
                Forward P/E, revenue growth, margins, debt, weighted return across 3y / 5y / 10y.
                ETF expense ratios where applicable.
              </p>
            </li>
            <li class="card">
              <p class="eyebrow">Discount</p>
              <h3 class="mt-2 font-display text-xl tracking-tight text-bone">Is it on sale right now?</h3>
              <p class="mt-2 text-sm text-bone-dim">
                Current P/E vs the ticker's own 5-year median. Proximity to the 200-day
                and 200-week moving averages.
              </p>
            </li>
            <li class="card border-signal/30">
              <p class="eyebrow text-signal">Smart-money</p>
              <h3 class="mt-2 font-display text-xl tracking-tight text-bone">What are insiders, congress, and 13F filers doing?</h3>
              <p class="mt-2 text-sm text-bone-dim">
                SEC Form 4 buys and sells, role-weighted. STOCK Act PTRs from Congress.
                Quarterly 13F filings from tracked funds. Options unusual flow.
              </p>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Research tools (formerly "Powered by Nova") -->
  <section class="border-b border-bone/5">
    <div class="container-wide py-14 md:py-24">
      <div class="grid gap-8 md:gap-12 lg:grid-cols-2 lg:gap-16">
        <div>
          <p class="eyebrow">The research tools</p>
          <h2 class="mt-4 font-display text-display-md uppercase tracking-tight">
            How Nova works, in plain terms.
          </h2>
          <p class="mt-6 text-bone-dim">
            Nova looks at a company through 13 layers: quality, discount, and what
            large holders disclosed, plus momentum. Each layer can abstain when its
            data is missing. A missing layer is shown as missing, not filled in.
          </p>
          <p class="mt-4 text-bone-dim">
            The score is descriptive: it organises research so you can compare
            companies on the same framework. It is not a price prediction, not a
            recommendation, and not a reason to buy or sell on its own. Read the
            layers, read what would change the view, and make your own decision.
          </p>
          <p class="mt-4 text-bone-dim">
            You don't need any of it to be a member. The plan and the path come
            first. The tools are there when you want to dig into one company.
          </p>
          <a href="/blog" class="btn-secondary mt-8 inline-flex">Read the build notes →</a>
        </div>
        <div>
          <div class="card border-signal/20 bg-ink-800">
            <p class="eyebrow">Nova Score zones</p>
            <ul class="mt-6 space-y-2 font-mono text-sm">
              <li class="flex items-baseline justify-between">
                <span class="text-loss">● Selling</span>
                <span class="text-bone-mute">0 to 33</span>
              </li>
              <li class="flex items-baseline justify-between">
                <span class="text-warn">● Distribution</span>
                <span class="text-bone-mute">33 to 45</span>
              </li>
              <li class="flex items-baseline justify-between">
                <span class="text-bone-mute">● Neutral</span>
                <span class="text-bone-mute">45 to 60</span>
              </li>
              <li class="flex items-baseline justify-between">
                <span class="text-signal/80">● Accumulation</span>
                <span class="text-bone-mute">60 to 70</span>
              </li>
              <li class="flex items-baseline justify-between">
                <span class="text-signal">● Buying</span>
                <span class="text-bone-mute">70 to 100</span>
              </li>
            </ul>
            <p class="mt-6 text-xs text-bone-mute leading-relaxed">
              Layers without data <strong class="text-bone-dim">abstain</strong>. The
              score describes what the data shows. It is <strong class="text-bone-dim">not
              a price prediction</strong>.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Engineering rigor -->
  <section class="border-b border-bone/5 bg-ink-900">
    <div class="container-wide py-14 md:py-24">
      <div class="max-w-3xl">
        <p class="eyebrow">Engineering rigor, applied to money</p>
        <h2 class="mt-4 font-display text-display-md uppercase tracking-tight">
          Why I trust the process.
        </h2>
        <div class="prose-ltm mt-8">
          <p>
            My day job is software for space missions. You don't ship that on vibes.
            Everything gets written down, tested and reviewed. I run my own money the
            same way, and that's what I teach.
          </p>
          <p>
            Every idea I share comes with the reasoning written down. When I'm wrong, I
            say so and we look at why. The losers usually teach more than the winners.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Founder section — kept below the fold per Luke's directive -->
  <section class="border-b border-bone/5">
    <div class="container-wide pt-14 pb-10 md:pt-24 md:pb-16">
      <div class="grid gap-8 md:gap-12 lg:grid-cols-5 lg:gap-16">
        <div class="lg:col-span-3">
          <p class="eyebrow">About the founder</p>
          <h2 class="mt-4 font-display text-display-lg uppercase tracking-tight">
            Luke Vasilion
          </h2>
          <p class="mt-4 text-xl text-bone-dim">
            Senior software engineer. Founder. Lifelong markets student.
          </p>

          <div class="prose-ltm mt-10">
            <p>
              I'm a software engineer with more than a decade building products that
              matter. Right now I'm at <strong>a.i. solutions</strong>, working on the
              frontend for FreeFlyer, astrodynamics software powering missions like the
              International Space Station, the James Webb Space Telescope, NASA's Artemis
              program, and the Lunar Gateway. Before that I led front-end work at
              <strong>Salamander Technologies</strong> (a platform used by 1.2 million
              daily users, including first responders), built a legislation processing
              system from sprint zero for the <strong>State of Michigan Senate</strong>,
              and shipped products at <strong>General Motors</strong> and
              <strong>Allstate</strong>.
            </p>
            <p>
              Outside of the day job, I run
              <a href="https://unyxwebsolutions.com" target="_blank" rel="noopener" class="text-signal underline decoration-signal/40 underline-offset-4 hover:decoration-signal">Unyx Web Solutions</a>
              , custom web development and hosting for 25+ clients. I built
              <strong>Nova</strong>, the research software behind the tools inside
              Leaving The Matrix. And before any of that, I was an
              All-American sprinter at Grand Valley State and a 2021 Michigan District 14
              motocross state champion. The competitive instinct and the engineering
              rigor end up in the same place: working systems that hold up under
              pressure.
            </p>
          </div>

          <!-- Elsewhere on the web -->
          <div class="mt-10">
            <p class="eyebrow">Elsewhere on the web</p>
            <ul class="mt-4 flex flex-wrap gap-3">
              <li>
                <a
                  href="https://unyxwebsolutions.com"
                  target="_blank"
                  rel="noopener"
                  class="group inline-flex items-center gap-2 rounded-full border border-bone/15 bg-ink-800/60 px-4 py-2 text-sm text-bone-dim transition-colors hover:border-signal/40 hover:text-signal"
                >
                  <span class="font-mono text-xs text-bone-mute group-hover:text-signal">↗</span>
                  Unyx Web Solutions
                  <span class="text-xs text-bone-mute">(agency)</span>
                </a>
              </li>
              <li>
                <a
                  href="https://www.unycross.com"
                  target="_blank"
                  rel="noopener"
                  class="group inline-flex items-center gap-2 rounded-full border border-bone/15 bg-ink-800/60 px-4 py-2 text-sm text-bone-dim transition-colors hover:border-signal/40 hover:text-signal"
                >
                  <span class="font-mono text-xs text-bone-mute group-hover:text-signal">↗</span>
                  unycross.com
                  <span class="text-xs text-bone-mute">(personal)</span>
                </a>
              </li>
            </ul>
          </div>
        </div>

        <div class="lg:col-span-2">
          <div class="relative">
            <div class="absolute -inset-3 rounded-2xl border border-signal/20 bg-signal/[0.03] -z-10"></div>
            <Image
              src={headshot}
              alt="Luke Vasilion with his family"
              widths={[320, 480, 720, 960]}
              sizes="(max-width: 1024px) 100vw, 480px"
              class="aspect-square w-full rounded-xl object-cover"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Career timeline -->
  <section class="border-y border-bone/5 bg-ink-900">
    <div class="container-wide py-14 md:py-24">
      <p class="eyebrow">Career timeline</p>
      <h2 class="mt-4 font-display text-display-md uppercase tracking-tight">Where I've built.</h2>

      <ol class="mt-12 space-y-4">
        {career.map((job, i) => (
          <li class="card flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <h3 class="font-display text-xl tracking-tight text-bone">{job.company}</h3>
              <p class="mt-1 text-sm text-signal">{job.role}</p>
              <p class="mt-3 max-w-2xl text-sm text-bone-dim">{job.description}</p>
            </div>
            <span class:list={[
              'inline-flex shrink-0 items-center self-start rounded-full border px-3 py-1 text-xs font-mono uppercase tracking-widest',
              i === 0 ? 'border-signal/40 bg-signal/10 text-signal' : 'border-bone/15 text-bone-mute'
            ]}>
              {job.period}
            </span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <NewsletterCallout
    source="about"
    eyebrow="Blue Pill · Free weekly email"
    headline="One lesson a week, taught through one company."
    description="The company is the case study. The lesson is the point, with the numbers shown, the bear case stated, and what would change the view. Free, weekly, unsubscribe in one click."
  />

  <!-- Final CTA -->
  <section class="container-wide pt-8 pb-24">
    <div class="card-interactive flex flex-col items-start gap-6 border-signal/30 p-12 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 class="font-display text-display-md uppercase tracking-tight">Come learn with us.</h2>
        <p class="mt-3 text-bone-dim">
          Write the plan. Follow the path. Ask questions in the Discord.
        </p>
      </div>
      <a href="/membership" class="btn-primary whitespace-nowrap">
        See membership
      </a>
    </div>
  </section>
</Layout>
