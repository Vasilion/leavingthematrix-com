---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import headshot from '../assets/headshot.png';
import { SITE } from '../lib/site';

const career = [
  {
    company: 'a.i. solutions',
    role: 'Senior Space Products Frontend Engineer',
    period: 'Current',
    description:
      "Building the frontend for FreeFlyer, an astrodynamics suite powering missions for the International Space Station, James Webb Space Telescope, NASA's Artemis program, Lunar Gateway, and Dream Chaser.",
  },
  {
    company: 'State of Michigan, Senate',
    role: 'Full Stack Developer',
    period: '2022 – 2025',
    description:
      'Architected Eva from sprint zero — a legislation processing platform streamlining bills, amendments, and resolutions. Lead front-end developer on a team of ten.',
  },
  {
    company: 'Salamander Technologies',
    role: 'Software Developer',
    period: '2020 – 2022',
    description:
      'Led front-end development for Salamander LIVE, used by 1.2M+ daily users including first responders. Shipped the v66 release: 138 features, zero post-release bugs.',
  },
  {
    company: 'Allstate',
    role: 'Software Developer',
    period: '2019 – 2020',
    description:
      'Built a secure agent portal in React, replacing the legacy system to meet modern compliance requirements.',
  },
  {
    company: 'General Motors',
    role: 'Software Developer',
    period: '2017 – 2018',
    description:
      "Worked on the Next-Gen Vehicle Configurator, the Marketing Admin CMS, and GM Brazil's Shop Click Drive platform.",
  },
];

const credentials = [
  {
    label: 'B.S. Information Systems',
    detail: 'Grand Valley State University · Class of 2017',
  },
  {
    label: 'All-American Sprinter',
    detail: 'GVSU Track & Field · 60m Dash, Sprint Relays · GLIAC All-Conference · MVP',
  },
  {
    label: '2021 District 14 Motocross State Champion',
    detail: 'Vet Sport Open · 9 wins · 26 podium finishes',
  },
];
---

<Layout
  title="About"
  description="Luke Vasilion runs Leaving The Matrix. Senior software engineer building for space missions, founder of Unyx Web Solutions, and the author of every signal posted in the Discord."
>
  <section class="border-b border-bone/5">
    <div class="container-wide pt-24 pb-16">
      <div class="grid gap-12 lg:grid-cols-5 lg:gap-16">
        <div class="lg:col-span-3">
          <p class="eyebrow">About the founder</p>
          <h1 class="mt-4 font-display text-display-lg uppercase tracking-tight">
            Luke Vasilion
          </h1>
          <p class="mt-4 text-xl text-bone-dim">
            Senior software engineer. Founder. Lifelong markets student.
          </p>

          <div class="prose-ltm mt-10">
            <p>
              I'm a software engineer with more than a decade building products that matter.
              Right now I'm at <strong>a.i. solutions</strong>, working on the frontend for
              FreeFlyer — astrodynamics software powering missions like the International Space
              Station, the James Webb Space Telescope, NASA's Artemis program, and the Lunar
              Gateway. Before that I led
              front-end work at <strong>Salamander Technologies</strong> (a platform used by
              1.2 million daily users, including first responders), built a legislation
              processing system from sprint zero for the <strong>State of Michigan Senate</strong>,
              and shipped products at <strong>General Motors</strong> and <strong>Allstate</strong>.
            </p>
            <p>
              Outside of the day job, I run <strong>Unyx Web Solutions</strong> — custom web
              development and hosting for 25+ clients. I'm building <strong>Nova</strong>, a
              private trading copilot that powers the research surfaced inside this Discord.
              And before any of that, I was an All-American sprinter at Grand Valley State and
              a 2021 Michigan District 14 motocross state champion. The competitive instinct
              and the engineering rigor end up in the same place: working systems that hold up
              under pressure.
            </p>
          </div>
        </div>

        <div class="lg:col-span-2">
          <div class="relative">
            <div class="absolute -inset-3 rounded-2xl border border-signal/20 bg-signal/[0.03] -z-10"></div>
            <Image
              src={headshot}
              alt="Luke Vasilion with his family"
              widths={[320, 480, 720, 960]}
              sizes="(max-width: 1024px) 100vw, 480px"
              class="aspect-square w-full rounded-xl object-cover"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="container-wide py-24">
    <div class="max-w-3xl">
      <p class="eyebrow">Why Leaving The Matrix exists</p>
      <h2 class="mt-4 font-display text-display-md uppercase tracking-tight">
        Engineering rigor, applied to markets.
      </h2>
      <div class="prose-ltm mt-8">
        <p>
          Most "stock-pick" services fall into one of two camps: hype machines that vanish when
          a trade goes wrong, or expensive black-box subscriptions that teach you nothing about
          how the call was made. I've never been able to stand either.
        </p>
        <p>
          What I built instead is a community that operates the way I operate at work — every
          decision documented, every thesis written down, every closed position reviewed
          honestly including the losers. Education for members who want to actually understand
          markets, not just receive tickers. The framework is layered:
          <strong>quality × discount × smart-money confirmation</strong>, with technicals as
          context. Same lens Nova uses to score every name.
        </p>
        <p>
          And markets are only one piece of the picture. The community covers the unsexy work
          too — frameworks for managing debt, thinking long-term, and the discipline that
          separates investors from gamblers. <strong>Educational content only.</strong> I'm not
          a financial adviser; I don't give personalized recommendations. I share how I think
          and what I do — you decide what fits your situation.
        </p>
        <p class="text-bone-mute italic">
          Note: this section will get sharpened once Luke and I lock the LTM-specific
          positioning copy — placeholder framing for now.
        </p>
      </div>
    </div>
  </section>

  <section class="border-y border-bone/5 bg-ink-900">
    <div class="container-wide py-24">
      <p class="eyebrow">Career timeline</p>
      <h2 class="mt-4 font-display text-display-md uppercase tracking-tight">Where I've built.</h2>

      <ol class="mt-12 space-y-4">
        {career.map((job, i) => (
          <li class="card flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <h3 class="font-display text-xl tracking-tight text-bone">{job.company}</h3>
              <p class="mt-1 text-sm text-signal">{job.role}</p>
              <p class="mt-3 max-w-2xl text-sm text-bone-dim">{job.description}</p>
            </div>
            <span class:list={[
              'inline-flex shrink-0 items-center self-start rounded-full border px-3 py-1 text-xs font-mono uppercase tracking-widest',
              i === 0 ? 'border-signal/40 bg-signal/10 text-signal' : 'border-bone/15 text-bone-mute'
            ]}>
              {job.period}
            </span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="container-wide py-24">
    <p class="eyebrow">Background</p>
    <h2 class="mt-4 font-display text-display-md uppercase tracking-tight">Education & competition.</h2>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {credentials.map((c) => (
        <div class="card">
          <p class="font-display text-xl tracking-tight text-bone">{c.label}</p>
          <p class="mt-2 text-sm text-bone-dim">{c.detail}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container-wide pb-24">
    <div class="card-interactive flex flex-col items-start gap-6 border-signal/30 p-12 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 class="font-display text-display-md uppercase tracking-tight">Come trade with us.</h2>
        <p class="mt-3 text-bone-dim">All the work above ends up inside the Discord, every day.</p>
      </div>
      <a href={SITE.discord.subscribe} target="_blank" rel="noopener" class="btn-primary whitespace-nowrap">
        Join the Discord
      </a>
    </div>
  </section>
</Layout>
