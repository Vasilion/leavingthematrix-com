---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import BookBuyButton from '../../components/BookBuyButton.astro';
import BookFonts from '../../components/BookFonts.astro';
import cover from '../../assets/books/disqualified-cover.jpg';
import { BOOK, CHAPTERS, CHAPTERS_PLUS, EXCERPT, EXCERPT_TAKEAWAY, FAQ, WHO_FOR } from '../../lib/book';
import type { Chapter, FaqItem } from '../../lib/book';

const pageUrl: string = new URL(BOOK.path, Astro.site).toString();
const coverAlt: string = `Cover of ${BOOK.title} by ${BOOK.author}: a man in a hooded jacket walks beside his small daughter through a muddy puddle, under a red stamp reading DISQUALIFIED.`;

const bookLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: BOOK.title,
  alternativeHeadline: BOOK.subtitle,
  author: { '@type': 'Person', name: BOOK.author },
  bookFormat: 'https://schema.org/EBook',
  numberOfPages: BOOK.pages,
  inLanguage: 'en',
  image: new URL(BOOK.ogImage, Astro.site).toString(),
  url: pageUrl,
  description: BOOK.hook,
  offers: {
    '@type': 'Offer',
    price: BOOK.priceAmount,
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    url: pageUrl,
  },
};
---

<Layout
  title={`${BOOK.title}: a memoir that teaches money`}
  description="Food stamps, a regretted Challenger, a Special Forces disqualification, and how Luke Vasilion rebuilt from $10 an hour. A story first, with real money lessons. PDF + EPUB."
  image={BOOK.ogImage}
  imageAlt={`${BOOK.title} by ${BOOK.author}, ${BOOK.subtitle}`}
  jsonLd={bookLd}
>
  <BookFonts slot="head" />

  <div class="font-book text-book-paper">
    <div
      id="checkout-error"
      role="alert"
      style="display: none;"
      class="border-b border-book-red/40 bg-book-red/15 px-4 py-3 text-center text-sm text-book-paper"
    >
      Checkout couldn't start just now. Please try again in a minute, or email
      <span class="font-semibold">luke@unyxwebsolutions.com</span>.
    </div>

    <section class="relative overflow-hidden border-b border-bone/10">
      <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-signal/40 to-transparent" aria-hidden="true"></div>
      <div class="container-wide grid items-center gap-10 py-12 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:gap-14 md:py-20">
        <div class="mx-auto w-full max-w-[17rem] sm:max-w-xs md:max-w-sm">
          <Image
            src={cover}
            alt={coverAlt}
            width={900}
            widths={[320, 480, 640, 900]}
            sizes="(max-width: 640px) 272px, (max-width: 768px) 320px, 384px"
            loading="eager"
            fetchpriority="high"
            class="w-full rounded-sm shadow-[0_30px_80px_-20px_rgba(215,25,47,0.35),0_20px_50px_rgba(0,0,0,0.8)] ring-1 ring-white/10"
          />
        </div>

        <div class="text-center md:text-left">
          <p class="font-mono text-xs uppercase tracking-[0.25em] text-book-red">New book · {BOOK.author}</p>
          <h1 class="mt-4 font-book-display text-[clamp(2.75rem,11vw,5.5rem)] uppercase leading-[0.92] tracking-tight text-book-paper">
            {BOOK.title}
          </h1>
          <p class="mt-4 text-lg font-semibold leading-snug text-book-paper/90 md:text-xl">{BOOK.subtitle}</p>
          <p class="mx-auto mt-6 max-w-xl border-l-4 border-book-red pl-4 text-left text-lg leading-relaxed text-book-paper/85 md:mx-0">
            {BOOK.hook}
          </p>
          <div class="mt-8 flex flex-col items-center gap-4 sm:flex-row md:justify-start">
            <BookBuyButton class="w-full sm:w-auto" />
            <p class="text-sm text-bone-mute">PDF + EPUB · instant download</p>
          </div>
        </div>
      </div>
    </section>

    <section class="border-b border-bone/10 bg-ink-900">
      <div class="container-prose py-16 md:py-20">
        <p class="font-mono text-xs uppercase tracking-[0.25em] text-book-red">From the cold open</p>
        <blockquote class="mt-6 space-y-5 text-lg leading-relaxed text-book-paper/90 md:text-xl">
          {EXCERPT.map((paragraph: string) =>
            paragraph === 'Disqualified.' ? (
              <p class="font-book-display text-3xl uppercase tracking-tight text-book-red md:text-4xl">{paragraph}</p>
            ) : (
              <p>{paragraph}</p>
            ),
          )}
          <p>
            If you take one thing from this book, take this:
            <strong class="font-bold text-book-paper">{EXCERPT_TAKEAWAY}</strong>
          </p>
        </blockquote>
        <p class="mt-10 text-base leading-relaxed text-bone-dim md:text-lg">{BOOK.pitch}</p>
      </div>
    </section>

    <section class="border-b border-bone/10">
      <div class="container-wide py-16 md:py-20">
        <div class="mx-auto max-w-3xl">
          <p class="font-mono text-xs uppercase tracking-[0.25em] text-book-red">What's inside</p>
          <h2 class="mt-3 font-book-display text-3xl uppercase tracking-tight md:text-4xl">Every chapter is a real chapter</h2>
          <p class="mt-3 text-bone-dim">Each one ends with "Your move this week": a few small things to do before the next.</p>
          <ol class="mt-8 divide-y divide-bone/10 border-y border-bone/10">
            {CHAPTERS.map((chapter: Chapter) => (
              <li class="grid grid-cols-[2.5rem_minmax(0,1fr)] gap-3 py-4 sm:grid-cols-[3rem_minmax(0,1fr)]">
                <span class="pt-0.5 font-mono text-sm tabular-nums text-book-red">
                  {chapter.number === '' ? '00' : chapter.number.padStart(2, '0')}
                </span>
                <span>
                  <span class="block font-bold text-book-paper">{chapter.title}</span>
                  <span class="mt-0.5 block text-sm leading-relaxed text-bone-dim sm:text-base">{chapter.lesson}</span>
                </span>
              </li>
            ))}
            <li class="grid grid-cols-[2.5rem_minmax(0,1fr)] gap-3 py-4 sm:grid-cols-[3rem_minmax(0,1fr)]">
              <span class="pt-0.5 font-mono text-sm text-book-red">+</span>
              <span>
                <span class="block font-bold text-book-paper">Plus</span>
                <span class="mt-0.5 block text-sm leading-relaxed text-bone-dim sm:text-base">{CHAPTERS_PLUS}</span>
              </span>
            </li>
          </ol>
        </div>
      </div>
    </section>

    <section class="border-b border-bone/10 bg-ink-900">
      <div class="container-wide grid gap-12 py-16 md:grid-cols-2 md:py-20">
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.25em] text-book-red">Who it's for</p>
          <h2 class="mt-3 font-book-display text-3xl uppercase tracking-tight md:text-4xl">This is for you if</h2>
          <ul class="mt-6 space-y-4">
            {WHO_FOR.map((line: string) => (
              <li class="flex gap-3 text-lg leading-relaxed text-book-paper/90">
                <span class="mt-3 h-1.5 w-3 shrink-0 bg-book-red" aria-hidden="true"></span>
                <span>{line}</span>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.25em] text-book-red">About the author</p>
          <h2 class="mt-3 font-book-display text-3xl uppercase tracking-tight md:text-4xl">{BOOK.author}</h2>
          <p class="mt-6 text-lg leading-relaxed text-bone-dim">{BOOK.bio}</p>
        </div>
      </div>
    </section>

    <section class="border-b border-bone/10">
      <div class="container-prose py-16 md:py-20">
        <p class="font-mono text-xs uppercase tracking-[0.25em] text-book-red">FAQ</p>
        <h2 class="mt-3 font-book-display text-3xl uppercase tracking-tight md:text-4xl">Questions</h2>
        <dl class="mt-8 space-y-8">
          {FAQ.map((item: FaqItem) => (
            <div>
              <dt class="text-lg font-bold text-book-paper">{item.question}</dt>
              <dd
                class="mt-2 leading-relaxed text-bone-dim [&_a]:text-book-paper [&_a]:underline [&_a]:decoration-book-red [&_a]:underline-offset-4 hover:[&_a]:text-white"
                set:html={item.answer}
              />
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section>
      <div class="container-prose py-16 text-center md:py-24">
        <h2 class="font-book-display text-[clamp(2rem,8vw,3.5rem)] uppercase leading-none tracking-tight">
          You need a Plan B before you need a Plan B.
        </h2>
        <p class="mt-5 text-bone-dim">{BOOK.title} · PDF + EPUB · {BOOK.price}</p>
        <div class="mt-8 flex justify-center">
          <BookBuyButton class="w-full sm:w-auto" />
        </div>
        <p class="mt-6 text-sm text-bone-mute">
          Already bought it? <a href="/disqualified/resend" class="text-book-paper underline decoration-book-red underline-offset-4 hover:text-white">Get your download links again</a>.
        </p>
      </div>
    </section>

    <div class="fixed inset-x-0 bottom-0 z-30 border-t border-bone/10 bg-black/90 px-4 pb-[calc(env(safe-area-inset-bottom)+0.75rem)] pt-3 backdrop-blur md:hidden">
      <BookBuyButton size="md" label={`Buy ${BOOK.title} · ${BOOK.price}`} />
    </div>
  </div>
</Layout>

<script>
  const params: URLSearchParams = new URLSearchParams(window.location.search);
  const banner: HTMLElement | null = document.getElementById('checkout-error');
  if (banner !== null && params.get('checkout') === 'error') {
    banner.style.display = 'block';
  }
</script>
