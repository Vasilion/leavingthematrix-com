---
import Layout from '../layouts/Layout.astro';
import PricingTier from '../components/PricingTier.astro';
import PerformanceProof from '../components/PerformanceProof.astro';
import Testimonials from '../components/Testimonials.astro';
import Pill from '../components/Pill.astro';
import { PRICING_TIERS } from '../lib/site';

// FAQ q/a are HTML strings — embedded spans color "Blue"/"Red" inside the
// "Blue Pill" / "Red Pill" tier names. Rendered via set:html below.
const PILL_BLUE = '<span class="text-sky-400">Blue</span> Pill';
const PILL_RED = '<span class="text-red-400">Red</span> Pill';

const faq = [
  {
    q: 'What do I actually get?',
    a: "A place to get your money in order and learn to invest, one step at a time. You write your own plan (budget, runway, safety net, debt order, goal), then follow a 12-week path: the plan first, then investing basics, then the basics of swing trading and selling options. Each week there's a lesson that uses one company as the case study. The community lives in our Discord, and the research tools are there when you want to go deeper.",
  },
  {
    q: 'Is this financial advice?',
    a: "No. Everything is for educational and informational purposes only. We share frameworks and what we do — we don't make personalized recommendations and we're not your financial adviser. You're responsible for your own decisions. See the full disclaimer.",
  },
  {
    q: `How does ${PILL_RED} work?`,
    a: 'You sign up here through Stripe, you get the Pro role in our community automatically, and you land in the members area where Nova lives. Cancel anytime in your billing dashboard.',
  },
  {
    q: `How does cancellation work?`,
    a: 'Cancel anytime in your account settings. Your access continues until the end of the current billing period — no prorated refunds, no questions asked. You can reactivate any time before the period ends.',
  },
  {
    q: `What is the ${PILL_BLUE} newsletter?`,
    a: 'A free weekly read on what the smart money is doing — a taste of the framework Nova runs every day. Educational content only. Launching with Nova.',
  },
  {
    q: 'Do you teach options?',
    a: "Yes, as education, and only after your plan and the investing basics. Selling options is Stage 3 of the path: cash-secured puts first (what the collateral is, where breakeven sits, what happens if you're assigned), then covered calls and the wheel, practised on paper. Not for gambling, and no trades to copy.",
  },
  {
    q: "What if I'm a complete beginner?",
    a: "Good. That's who this is built for. You start by writing your money plan, and the path takes it one step at a time from there. The community is friendly to first-timers, and nobody minds a beginner question.",
  },
  {
    q: 'Do you cover anything beyond markets?',
    a: 'Yes. The first stage is all money basics: a budget, how long your cash would last, a safety net with a date, the order to pay off debt, and a goal number. It is all educational, frameworks for thinking, not personalized financial advice.',
  },
  {
    q: 'I am already a member through Discord. What changes?',
    a: 'Nothing for now. Existing Standard and Pro subscribers keep their current access uninterrupted. Any migration to the new model will be communicated directly with plenty of notice.',
  },
];
---

<Layout
  title="Membership"
  description="Two tiers. Blue Pill — free newsletter. Red Pill — $79.99/mo: write your money plan, follow a 12-week path from plan to investing basics, a weekly lesson, and the community."
>
  <section class="border-b border-bone/5">
    <div class="container-wide py-14 md:py-24">
      <div class="grid gap-8 md:gap-12 lg:grid-cols-12 lg:gap-16 lg:items-center">
        <div class="lg:col-span-7">
          <p class="eyebrow">Membership</p>
          <h1 class="mt-4 font-display text-4xl uppercase leading-[0.95] tracking-tight sm:text-5xl md:text-display-xl">
            Two pills. <span class="text-signal">One choice.</span>
          </h1>
          <p class="mt-6 text-lg text-bone-dim">
            <Pill color="blue" /> keeps you informed with a weekly newsletter — a
            taste of the framework and the names on our radar.
            <Pill color="red" /> is the whole thing: a written plan for your money,
            a 12-week path from plan to investing basics to selling options, a
            weekly lesson, the community, and the research tools.
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a href="#pricing" class="btn-primary">
              See the tiers
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
            <a href="#faq" class="btn-secondary">FAQ</a>
          </div>
        </div>

        <aside class="lg:col-span-5">
          <div class="card border-signal/30 bg-ink-800">
            <p class="eyebrow text-signal">What <Pill color="red" /> includes</p>
            <ul class="mt-6 space-y-4 text-sm text-bone-dim">
              <li class="flex items-start gap-3">
                <span class="mt-1.5 h-1.5 w-1.5 flex-none rounded-full bg-signal" aria-hidden="true"></span>
                <span><strong class="text-bone">My Plan</strong> — budget, runway, safety net, debt order and goal, written down in one place.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-1.5 h-1.5 w-1.5 flex-none rounded-full bg-signal" aria-hidden="true"></span>
                <span><strong class="text-bone">A 12-week path</strong> — your plan, then investing basics, then swing trading and selling options, in order.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-1.5 h-1.5 w-1.5 flex-none rounded-full bg-signal" aria-hidden="true"></span>
                <span><strong class="text-bone">A weekly lesson + the community</strong> — one idea a week, and the Pro role in our Discord.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-1.5 h-1.5 w-1.5 flex-none rounded-full bg-signal" aria-hidden="true"></span>
                <span><strong class="text-bone">Research tools</strong> — Nova Lookup, Screener and the Smart Money tab, for when you want to go deeper.</span>
              </li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section id="pricing" class="container-wide py-14 md:py-24 scroll-mt-24">
    <div class="grid gap-6 md:grid-cols-2">
      {PRICING_TIERS.map((tier) => <PricingTier {...tier} />)}
    </div>

    <p class="mt-12 text-center text-sm text-bone-mute">
      Cancel anytime. Educational content only — never personalized financial advice.
    </p>
  </section>

  <PerformanceProof />

  <section class="border-y border-bone/5 bg-ink-900">
    <div class="container-wide py-14 md:py-24">
      <p class="eyebrow">What you get</p>
      <h2 class="mt-4 font-display text-display-lg uppercase tracking-tight">
        The full picture.
      </h2>
      <p class="mt-4 max-w-2xl text-bone-dim">
        <Pill color="red" /> is built for members who want to actually understand
        their money and markets, not just receive tickers. Four parts, one calm order.
      </p>

      <div class="mt-8 md:mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        <div class="card">
          <p class="eyebrow">Your plan</p>
          <h3 class="mt-3 font-display text-xl tracking-tight text-bone">Written down first.</h3>
          <p class="mt-3 text-sm text-bone-dim">
            Budget. Runway. A safety net with a date. Debt payoff order. A goal
            number. A quarterly review to keep it true.
          </p>
        </div>
        <div class="card">
          <p class="eyebrow">Your path</p>
          <h3 class="mt-3 font-display text-xl tracking-tight text-bone">Twelve weeks, in order.</h3>
          <p class="mt-3 text-sm text-bone-dim">
            Plan first. Then investing basics: automation, a core, valuation,
            sizing, a rule for the next fall. Then swing trading and selling
            options, on paper. Plus a weekly lesson.
          </p>
        </div>
        <div class="card">
          <p class="eyebrow">Community</p>
          <h3 class="mt-3 font-display text-xl tracking-tight text-bone">Real conversations.</h3>
          <p class="mt-3 text-sm text-bone-dim">
            Pro role in the Discord. People working through the same path, asking
            questions, and sharing what they're learning.
          </p>
        </div>
        <div class="card border-signal/30">
          <p class="eyebrow text-signal">Research tools</p>
          <h3 class="mt-3 font-display text-xl tracking-tight text-bone">When you want to go deeper.</h3>
          <p class="mt-3 text-sm text-bone-dim">
            Nova Lookup, the Screener, and the Smart Money tab (insider buys,
            congressional trades, 13F flows). Optional, never required.
          </p>
        </div>
      </div>
    </div>
  </section>

  <Testimonials />

  <section class="container-wide py-14 md:py-24">
    <p class="eyebrow">FAQ</p>
    <h2 class="mt-4 font-display text-display-lg uppercase tracking-tight">Common questions</h2>

    <div class="mt-8 md:mt-12 grid gap-4">
      {faq.map((item) => (
        <details class="card group">
          <summary class="flex cursor-pointer items-center justify-between gap-4 list-none">
            <span class="font-display text-xl tracking-tight text-bone" set:html={item.q}></span>
            <span class="text-signal transition-transform group-open:rotate-45">+</span>
          </summary>
          <p class="mt-4 text-bone-dim" set:html={item.a}></p>
        </details>
      ))}
    </div>
  </section>

  <section class="container-wide pb-24">
    <div class="card-interactive flex flex-col items-start gap-6 border-signal/30 p-12 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 class="font-display text-display-md uppercase tracking-tight">Ready when you are.</h2>
        <p class="mt-3 text-bone-dim">Pick a pill and you're in.</p>
      </div>
      <a href="#pricing" class="btn-primary whitespace-nowrap">
        See the tiers
      </a>
    </div>
  </section>
</Layout>
