---
import Layout from '../layouts/Layout.astro';
import NewsletterCallout from '../components/NewsletterCallout.astro';

interface Tool {
  n: string;
  name: string;
  tagline: string;
  href: string | null;
  status: 'live' | 'building';
  body: string;
  detail: string;
}

const tools: Tool[] = [
  {
    n: '01',
    name: 'Own It Lower',
    tagline: 'Cash-secured put screener',
    href: 'https://ownitlower.leavingthematrix.io',
    status: 'live',
    body:
      'Selling a cash-secured put is an agreement to buy a company you already want to own, at a price below where it trades today, and to be paid for the wait. Own It Lower screens for the places that trade is actually worth taking: where the premium compensates for the obligation and the underlying is a business you would be content to hold if assigned.',
    detail: 'Free · No account required',
  },
  {
    n: '02',
    name: 'This Week',
    tagline: 'Weekly top 10 board',
    href: 'https://nova.leavingthematrix.io/this-week',
    status: 'live',
    body:
      'The ten highest Nova Scores from the latest daily scan that also clear the Rule of 40, a quick check on growth plus profitability. It is a research starting point, not a buy list. Free to read.',
    detail: 'Free · Updated weekly',
  },
  {
    n: '03',
    name: 'The Money Plan',
    tagline: 'Free budget and payoff plan',
    href: '/tools/money-plan',
    status: 'live',
    body:
      'The unglamorous side of the framework. Answer about 15 questions and get a plan built from the book Disqualified: where every dollar goes this month, how long you could last with no income, a safety net with dates, the order to pay your debt in, and a 30-day checklist with your numbers in it.',
    detail: 'Free · No account required',
  },
];
---

<Layout
  title="Tools"
  description="Free tools I built: a money plan from the book Disqualified, a cash-secured put screener, and a weekly top 10 board."
>
  <section class="border-b border-bone/5">
    <div class="container-prose py-24">
      <p class="eyebrow">Tools</p>
      <h1 class="mt-4 font-display text-display-xl uppercase tracking-tight">
        What we build
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-bone-dim">
        Every tool here came out of our own desk needing it. We publish the ones
        that turned out to be useful to more than us.
      </p>
    </div>
  </section>

  <section>
    <div class="container-prose py-20">
      <ul class="space-y-8">
        {tools.map((tool) => (
          <li>
            {tool.href ? (
              <a
                href={tool.href}
                class="card-interactive block"
                rel="noopener"
              >
                <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2">
                  <p class="eyebrow text-signal">{tool.n}</p>
                  <h2 class="font-display text-2xl sm:text-3xl uppercase tracking-tight text-bone">
                    {tool.name}
                  </h2>
                  <p class="text-sm text-bone-mute">{tool.tagline}</p>
                </div>
                <p class="mt-4 leading-relaxed text-bone-dim">{tool.body}</p>
                <p class="mt-4 text-xs uppercase tracking-widest text-signal">
                  {tool.detail} &rarr;
                </p>
              </a>
            ) : (
              <div class="card opacity-80">
                <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2">
                  <p class="eyebrow text-bone-mute">{tool.n}</p>
                  <h2 class="font-display text-2xl sm:text-3xl uppercase tracking-tight text-bone-dim">
                    {tool.name}
                  </h2>
                  <p class="text-sm text-bone-mute">{tool.tagline}</p>
                </div>
                <p class="mt-4 leading-relaxed text-bone-dim">{tool.body}</p>
                <p class="mt-4 text-xs uppercase tracking-widest text-bone-mute">
                  {tool.detail}
                </p>
              </div>
            )}
          </li>
        ))}
      </ul>

      <p class="mt-12 text-sm text-bone-mute">
        Educational only, never personalized financial advice. These tools
        show you the research and the math. The decisions stay yours.
      </p>
    </div>
  </section>

  <NewsletterCallout
    source="tools"
    eyebrow="Free Your Mind · Free weekly newsletter"
    headline="See the framework these tools came out of."
    description="One ticker per issue through the same Quality × Discount × Smart-money lens the tools automate. Free, weekly, unsubscribe in one click."
  />
</Layout>
