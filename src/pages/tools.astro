---
import Layout from '../layouts/Layout.astro';
import NewsletterCallout from '../components/NewsletterCallout.astro';

// Order is the point of this page (Brand Gate A, 2026-10-28): build the base
// first (Money Plan), then the free weekly email, then advanced research only
// if you want it. Own It Lower and This Week stay free and stay listed, just
// last, and labelled advanced.

interface Tool {
  n: string;
  name: string;
  tagline: string;
  href: string;
  body: string[];
  detail: string;
}

const moneyPlan: Tool = {
  n: '01',
  name: 'The Money Plan',
  tagline: 'Free · Build the base',
  href: '/tools/money-plan',
  body: [
    'Before you invest, build the base. Answer about 15 questions and get a budget, your runway, a safety net, and a debt payoff order, built from the book Disqualified. Free, as a PDF. About 3 to 4 minutes.',
    "No email until you've seen your numbers. Your answers aren't saved.",
    'Next step after your plan: the free weekly email, one money lesson a week, building on your plan.',
  ],
  detail: 'Build my plan',
};

const advanced: Tool[] = [
  {
    n: '03',
    name: 'Own It Lower',
    tagline: 'Free · Advanced · Stage 3 practice',
    href: 'https://ownitlower.leavingthematrix.io',
    body: [
      "A free cash-secured put screener: name the price you'd happily buy a company at, and read the arithmetic back. Collateral, premium, breakeven, return on collateral, and support, in words you can check at a broker. Free, no account required, on its own site.",
      'New to this? Start with The Money Plan first.',
    ],
    detail: 'Free · No account required',
  },
  {
    n: '04',
    name: 'This Week',
    tagline: 'Free · Advanced research',
    href: 'https://nova.leavingthematrix.io/this-week',
    body: [
      "A research list of ten names, explained as method first, names second: ranked by Nova Score from the latest daily scan, filtered to Rule of 40 ≥ 40. A research starting point, not a buy list. The full research breakdown is in the members area's Advanced Wing.",
    ],
    detail: 'Free · Updated daily',
  },
];
---

<Layout
  title="Tools"
  description="Three free tools, in the order to use them: the Money Plan to build the base, the free weekly email, then advanced research only if you want it."
>
  <section class="border-b border-bone/5">
    <div class="container-prose py-24">
      <p class="eyebrow">Tools</p>
      <h1 class="mt-4 font-display text-display-xl uppercase tracking-tight">
        Free tools
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-bone-dim">
        Three free tools, in the order to use them.
      </p>
      <p class="mt-3 max-w-2xl text-lg text-bone-dim">
        Build the base first, then learn weekly, then, only if you want to, explore advanced research.
      </p>
    </div>
  </section>

  <section>
    <div class="container-prose py-20">
      <a href={moneyPlan.href} class="card-interactive block border-signal/30">
        <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2">
          <p class="eyebrow text-signal">{moneyPlan.n}</p>
          <h2 class="font-display text-2xl sm:text-3xl uppercase tracking-tight text-bone">{moneyPlan.name}</h2>
          <p class="text-sm text-bone-mute">{moneyPlan.tagline}</p>
        </div>
        {moneyPlan.body.map((p) => <p class="mt-4 leading-relaxed text-bone-dim">{p}</p>)}
        <p class="mt-4 text-xs uppercase tracking-widest text-signal">{moneyPlan.detail} &rarr;</p>
      </a>
    </div>
  </section>

  <NewsletterCallout
    source="tools"
    eyebrow="02 · Blue Pill · Free weekly email"
    headline="One lesson a week, taught through one company."
    description="Plus the foundations that compound: debt, runway, safety net, DCA, ETF cores, sizing. No hype, no day-trading, no spam."
  />

  <section>
    <div class="container-prose py-20">
      <p class="eyebrow">Advanced, optional</p>
      <h2 class="mt-3 font-display text-2xl uppercase tracking-tight text-bone sm:text-3xl">
        Only after the foundations, only if you want to.
      </h2>

      <ul class="mt-10 space-y-8">
        {advanced.map((tool) => (
          <li>
            <a href={tool.href} class="card-interactive block" rel="noopener">
              <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2">
                <p class="eyebrow text-signal">{tool.n}</p>
                <h3 class="font-display text-2xl sm:text-3xl uppercase tracking-tight text-bone">{tool.name}</h3>
                <p class="text-sm text-bone-mute">{tool.tagline}</p>
              </div>
              {tool.body.map((p) => <p class="mt-4 leading-relaxed text-bone-dim">{p}</p>)}
              <p class="mt-4 text-xs uppercase tracking-widest text-signal">{tool.detail} &rarr;</p>
            </a>
          </li>
        ))}
      </ul>

      <p class="mt-12 text-sm text-bone-mute">
        Educational only, never personalized financial advice. These tools
        show you the research and the math. The decisions stay yours.
      </p>
    </div>
  </section>
</Layout>
