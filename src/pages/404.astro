---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 — Lost in the noise" description="The page you're looking for doesn't exist." noindex>
  <section class="container-wide flex min-h-[70vh] flex-col items-center justify-center py-24 text-center">
    <p class="eyebrow">404</p>
    <h1 class="mt-6 font-display text-display-xl uppercase tracking-tight">
      <span class="text-gradient-signal">Lost in the noise.</span>
    </h1>
    <p class="mt-6 max-w-xl text-lg text-bone-dim">
      That route doesn't exist — or it used to and we moved it. Try the home page,
      check the blog, or take the Red Pill.
    </p>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
      <a href="/" class="btn-primary">Back home</a>
      <a href="/blog" class="btn-secondary">Read the blog</a>
      <a href="/membership" class="btn-ghost">
        Leave the Matrix →
      </a>
    </div>

    <pre class="mt-16 overflow-x-auto rounded-md border border-bone/10 bg-ink-900 px-4 py-3 text-xs font-mono text-bone-mute"><code>$ curl -I {Astro.url.pathname}
HTTP/1.1 404 Not Found
status: lost-in-the-noise</code></pre>
  </section>
</Layout>
