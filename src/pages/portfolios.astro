---
import Layout from '../layouts/Layout.astro';
import Pill from '../components/Pill.astro';
import NewsletterCallout from '../components/NewsletterCallout.astro';

const etfSteps = [
  {
    n: '01',
    title: 'Universe scan',
    desc: '1,000+ liquid US-listed ETFs across equities, bonds, commodities, and alternative asset classes.',
  },
  {
    n: '02',
    title: 'Multi-factor ranking',
    desc: 'Each ETF ranked on a blend of trend, momentum, volatility, and risk-adjusted return.',
  },
  {
    n: '03',
    title: 'Top-100 filter',
    desc: 'Narrow to genuine leadership candidates. Names stuck in prolonged downtrends are dropped.',
  },
  {
    n: '04',
    title: 'Correlation gate',
    desc: 'Filter out ETFs that move in lockstep with each other to avoid hidden concentration.',
  },
  {
    n: '05',
    title: 'Top-10 selection',
    desc: 'Equal-weighted at 10% of account value. Diversified, but each winner is free to drive performance.',
  },
  {
    n: '06',
    title: 'Monthly rebalance',
    desc: "First trading day of the month. Cut weakness, hold winners. When nothing clears the threshold, cash is the position.",
  },
];

const stockSteps = [
  {
    n: '01',
    title: 'Top-down macro scan',
    desc: 'Identify the strongest markets, sectors, and themes driving current conditions.',
  },
  {
    n: '02',
    title: 'Screening',
    desc: 'A screen across 4,300+ instruments on NYSE, AMEX and NASDAQ. Output: a short list.',
  },
  {
    n: '03',
    title: 'Fundamental research',
    desc: 'Financials, growth, valuation, and qualified analyst takes. Trim the shortlist to candidates that hold up.',
  },
  {
    n: '04',
    title: 'Technical & indicator timing',
    desc: 'Fundamentals decide if it makes the cut. The chart decides when to buy.',
  },
  {
    n: '05',
    title: 'Portfolio fit + final pick',
    desc: "Sector exposure and risk balance considered. One pick per week makes the cut.",
  },
];

const stockReturnsBuckets = [
  { range: '20 to 40%', label: 'Small to moderate losses', sub: 'Cut quickly. Trailing stop fires.', tone: 'loss' },
  { range: '20 to 40%', label: 'Small to moderate wins', sub: 'Consistent, smaller returns.', tone: 'neutral' },
  { range: '40 to 100%', label: 'Big winners', sub: 'Where most of the return comes from.', tone: 'signal' },
  { range: '100%+', label: 'Outliers', sub: 'Rare, and they make the whole thing work.', tone: 'signalStrong' },
];

const stockWeekly = [
  {
    when: 'Monday',
    what: 'I buy',
    desc: '$550 invested in a real-money account at a random time. Entry price posted to open positions.',
  },
  {
    when: '1st of month',
    what: 'Performance report',
    desc: 'Monthly update on portfolio performance, position commentary, and market outlook.',
  },
  {
    when: 'When triggered',
    what: 'Exits',
    desc: 'Posted the day before I sell. The trailing stop decides, not my mood.',
  },
];

function toneClass(t: string) {
  switch (t) {
    case 'loss':
      return 'text-loss';
    case 'signal':
      return 'text-signal';
    case 'signalStrong':
      return 'text-signal';
    default:
      return 'text-bone';
  }
}
---

<Layout
  title="Portfolios"
  description="Two portfolios I run with written rules and publish as I go: ETF Momentum and Stock Picks. Every entry, every exit, every miss. Educational only."
>
  <!-- Hero -->
  <section class="border-b border-bone/5">
    <div class="container-wide py-14 md:py-24">
      <div class="max-w-3xl">
        <p class="eyebrow">Portfolios</p>
        <h1 class="mt-4 font-display text-display-xl uppercase tracking-tight">
          My money,<br />
          <span class="text-signal">in public.</span>
        </h1>
        <p class="mt-6 text-lg text-bone-dim">
          Two portfolios I run with rules written down ahead of time, and publish as
          I go. They're here so you can see what a process looks like when real
          money is on the line, not so you can copy it. Every entry, every exit,
          every miss.
        </p>
      </div>

      <!-- Anchor sub-nav -->
      <ul class="mt-12 grid gap-4 md:grid-cols-2">
        <li>
          <a href="#etf-momentum" class="card-interactive block">
            <p class="eyebrow">01</p>
            <p class="mt-2 font-display text-xl tracking-tight text-bone">ETF Momentum</p>
            <p class="mt-1 text-xs text-bone-mute">Systematic · 1,000+ ETF universe · monthly</p>
          </a>
        </li>
        <li>
          <a href="#stock-picks" class="card-interactive block">
            <p class="eyebrow">02</p>
            <p class="mt-2 font-display text-xl tracking-tight text-bone">Stock Picks</p>
            <p class="mt-1 text-xs text-bone-mute">High-growth small caps · public ledger</p>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <!-- ========== ETF MOMENTUM ========== -->
  <section id="etf-momentum" class="scroll-mt-24 border-b border-bone/5">
    <div class="container-wide py-14 md:py-24">
      <div class="grid gap-8 md:gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <p class="eyebrow text-signal">Portfolio 01</p>
          <h2 class="mt-4 font-display text-display-lg uppercase tracking-tight">ETF Momentum</h2>
          <p class="mt-4 text-xl text-bone-dim">
            A set of rules, run once a month. No predictions, no gut calls, no headlines.
          </p>
        </div>
        <div class="lg:col-span-7">
          <div class="prose-ltm">
            <p>
              ETF Momentum is the boring one, on purpose. A rules-based process
              screens the strongest names out of <strong>1,000+ liquid US-listed ETFs</strong> across
              equities, bonds, commodities, and alternative asset classes.
            </p>
            <p>
              Every month, each ETF is ranked on a blend of trend, momentum,
              volatility, and risk-adjusted return. The portfolio tilts toward
              genuine leadership and avoids names stuck in prolonged downtrends.
            </p>
            <p>
              The top 10 ETFs are pulled from the top-100 ranked list. Positions are
              equally weighted at 10% of account value, so it's diversified but each
              winner can still pull its weight. Correlation filters drop ETFs that move in
              lockstep, which would create hidden concentration. Result: exposure to
              several distinct market themes at once.
            </p>
            <p>
              Rebalance is monthly, on the first trading day. Responsive enough to
              react when leadership rotates, slow enough to avoid churn. Average hold
              runs <strong>two to five months</strong>. When nothing in the universe
              clears the system's threshold, <strong>cash is the position</strong>.
              Discipline above exposure.
            </p>
            <p>
              Dividends are reinvested at the next rebalance. I add $1,000 a month
              on top, so it's dollar-cost averaging layered on momentum. The goal is
              simple: compound over time and avoid overtrading, concentration and
              chasing whatever is hot.
            </p>
          </div>
        </div>
      </div>

      <!-- Key facts -->
      <div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        <div class="card">
          <p class="eyebrow">Universe</p>
          <p class="mt-2 font-display text-lg tracking-tight text-bone">1,000+ US-listed ETFs</p>
        </div>
        <div class="card">
          <p class="eyebrow">Holdings</p>
          <p class="mt-2 font-display text-lg tracking-tight text-bone">10 ETFs · equal-weight</p>
        </div>
        <div class="card">
          <p class="eyebrow">Rebalance</p>
          <p class="mt-2 font-display text-lg tracking-tight text-bone">Monthly · 1st trading day</p>
        </div>
        <div class="card">
          <p class="eyebrow">Hold period</p>
          <p class="mt-2 font-display text-lg tracking-tight text-bone">2 to 5 months avg</p>
        </div>
        <div class="card">
          <p class="eyebrow">Asset classes</p>
          <p class="mt-2 font-display text-lg tracking-tight text-bone">Equities · bonds · commodities · alts</p>
        </div>
        <div class="card">
          <p class="eyebrow">Risk control</p>
          <p class="mt-2 font-display text-lg tracking-tight text-bone">Cash position when threshold not met</p>
        </div>
        <div class="card">
          <p class="eyebrow">Correlation</p>
          <p class="mt-2 font-display text-lg tracking-tight text-bone">Lockstep filter prevents concentration</p>
        </div>
        <div class="card border-signal/30">
          <p class="eyebrow text-signal">DCA layer</p>
          <p class="mt-2 font-display text-lg tracking-tight text-bone">$1,000/mo contribution</p>
        </div>
      </div>

      <!-- How it works -->
      <div class="mt-10 md:mt-16">
        <div class="pl-5 md:pl-6">
          <p class="eyebrow">The process</p>
          <h3 class="mt-2 font-display text-display-md uppercase tracking-tight">Six steps. Once a month.</h3>
        </div>
        <ol class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {etfSteps.map((s) => (
            <li class="card flex gap-4">
              <span class="font-mono text-sm text-signal">{s.n}</span>
              <div>
                <p class="font-display text-lg tracking-tight text-bone">{s.title}</p>
                <p class="mt-2 text-sm text-bone-dim">{s.desc}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ========== STOCK PICKS ========== -->
  <section id="stock-picks" class="scroll-mt-24 border-b border-bone/5 bg-ink-900">
    <div class="container-wide py-14 md:py-24">
      <div class="grid gap-8 md:gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <p class="eyebrow text-signal">Portfolio 02</p>
          <h2 class="mt-4 font-display text-display-lg uppercase tracking-tight">Stock Picks</h2>
          <p class="mt-4 text-xl text-bone-dim">
            High-growth small caps. Higher risk. Real money. Public ledger.
          </p>
        </div>
        <div class="lg:col-span-7">
          <div class="prose-ltm">
            <p>
              Stock Picks is the high risk one. <strong>High-growth small caps</strong>,
              run with the same rules as everything else: a written thesis, a trailing
              stop, and real money on the line. Most people should own something like
              ETF Momentum long before anything like this.
            </p>
            <p>
              Picks come through a five-step funnel. Top-down macro scan identifies the
              strongest markets and themes. A screen across <strong>4,300+
              instruments</strong> on NYSE, AMEX and NASDAQ narrows that to a shortlist.
              Fundamental research trims it further: financials, growth, valuation and
              analyst views. Then I use the chart to time the entry. The final cut
              considers portfolio fit and current sector exposure. <strong>One pick per
              week.</strong>
            </p>
            <p>
              The portfolio runs <strong>30 to 40 positions</strong> on average, fewer
              during downturns and more during strength. Average hold is around four
              months but ranges from two weeks to two years. Losers cut fast on a
              trailing stop (price closes below it, I post the exit, and sell the next
              day). Winners run.
            </p>
            <p>
              Returns follow a <strong>trend-following distribution</strong>: many
              small outcomes and a few big winners that do most of the work. Expect a
              30 to 40% drawdown at some point over 10 years. That's normal for this
              style. Diversifying across sectors and countries (via ADRs) helps, but
              it doesn't make the swings go away. They're the cost of running it.
            </p>
            <p>
              <strong>Reinvestment engine:</strong> on the first trading day of each
              month, proceeds from closed positions and dividends are redistributed
              equally across all open picks. Minimum 10 open
              positions to prevent over-concentration. Minimum 5% cash reserve to
              avoid churn from tiny reinvestments.
            </p>
          </div>
        </div>
      </div>

      <!-- The Public Challenge -->
      <div class="mt-10 md:mt-16">
        <div class="card border-signal/30 bg-ink-800">
          <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
            <div class="max-w-2xl">
              <p class="eyebrow text-signal">The public experiment</p>
              <h3 class="mt-3 font-display text-display-md uppercase tracking-tight">$500 to $1M?</h3>
              <p class="mt-4 text-bone-dim">
                A 10 year experiment, in public: can steady weekly contributions and a
                written process get a real-money account from $500 to $1,000,000? I add
                $550 a week and raise it 10% a year. Every trade is documented, including
                the ones that don't work.
              </p>
            </div>
            <ul class="grid grid-cols-3 gap-4">
              <li class="text-center">
                <p class="font-display text-2xl tracking-tight text-bone">$550</p>
                <p class="mt-1 text-[10px] uppercase tracking-widest text-bone-mute">/wk invested</p>
              </li>
              <li class="text-center">
                <p class="font-display text-2xl tracking-tight text-bone">10y</p>
                <p class="mt-1 text-[10px] uppercase tracking-widest text-bone-mute">Jun 2024 → Jun 2034</p>
              </li>
              <li class="text-center">
                <p class="font-display text-2xl tracking-tight text-signal">~17.8%</p>
                <p class="mt-1 text-[10px] uppercase tracking-widest text-bone-mute">a year needed</p>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Key facts -->
      <div class="mt-10 md:mt-16 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        <div class="card">
          <p class="eyebrow">Universe</p>
          <p class="mt-2 font-display text-lg tracking-tight text-bone">4,300+ NYSE / AMEX / NASDAQ</p>
        </div>
        <div class="card">
          <p class="eyebrow">Holdings</p>
          <p class="mt-2 font-display text-lg tracking-tight text-bone">30 to 40 positions</p>
        </div>
        <div class="card">
          <p class="eyebrow">Hold period</p>
          <p class="mt-2 font-display text-lg tracking-tight text-bone">~4mo avg · 2 weeks to 2 years</p>
        </div>
        <div class="card">
          <p class="eyebrow">Exit</p>
          <p class="mt-2 font-display text-lg tracking-tight text-bone">Trailing stop</p>
        </div>
        <div class="card">
          <p class="eyebrow">Style</p>
          <p class="mt-2 font-display text-lg tracking-tight text-bone">High-growth small caps</p>
        </div>
        <div class="card">
          <p class="eyebrow">Reinvestment</p>
          <p class="mt-2 font-display text-lg tracking-tight text-bone">Monthly · equal-weight redistribution</p>
        </div>
        <div class="card">
          <p class="eyebrow">Min positions</p>
          <p class="mt-2 font-display text-lg tracking-tight text-bone">10 open · 5% cash reserve</p>
        </div>
        <div class="card">
          <p class="eyebrow">Filters</p>
          <p class="mt-2 font-display text-lg tracking-tight text-bone">$25M cap · $2 share · long only</p>
        </div>
      </div>

      <!-- How picks are chosen -->
      <div class="mt-10 md:mt-16">
        <div class="pl-5 md:pl-6">
          <p class="eyebrow">How picks are chosen</p>
          <h3 class="mt-2 font-display text-display-md uppercase tracking-tight">Five-step funnel.</h3>
        </div>
        <ol class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {stockSteps.map((s) => (
            <li class="card flex gap-4">
              <span class="font-mono text-sm text-signal">{s.n}</span>
              <div>
                <p class="font-display text-lg tracking-tight text-bone">{s.title}</p>
                <p class="mt-2 text-sm text-bone-dim">{s.desc}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <!-- Return distribution -->
      <div class="mt-10 md:mt-16">
        <div class="pl-5 md:pl-6">
          <p class="eyebrow">What to expect</p>
          <h3 class="mt-2 font-display text-display-md uppercase tracking-tight">Trend-following distribution.</h3>
          <p class="mt-4 max-w-2xl text-bone-dim">
            Lots of small outcomes. A few big winners that do most of the work. That's
            why the losers get cut fast.
          </p>
        </div>
        <ul class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
          {stockReturnsBuckets.map((b) => (
            <li class="card">
              <p class={['font-mono text-2xl', toneClass(b.tone)].join(' ')}>{b.range}</p>
              <p class="mt-2 font-display text-lg tracking-tight text-bone">{b.label}</p>
              <p class="mt-2 text-xs text-bone-mute">{b.sub}</p>
            </li>
          ))}
        </ul>
      </div>

      <!-- Weekly cycle -->
      <div class="mt-10 md:mt-16">
        <div class="pl-5 md:pl-6">
          <p class="eyebrow">The weekly cycle</p>
          <h3 class="mt-2 font-display text-display-md uppercase tracking-tight">From entry to exit.</h3>
        </div>
        <ul class="mt-10 grid gap-4 md:grid-cols-3">
          {stockWeekly.map((w) => (
            <li class="card">
              <p class="eyebrow text-signal">{w.when}</p>
              <p class="mt-3 font-display text-lg tracking-tight text-bone">{w.what}</p>
              <p class="mt-2 text-sm text-bone-dim">{w.desc}</p>
            </li>
          ))}
        </ul>
      </div>

      <!-- Drawdown caveat -->
      <div class="mt-10 md:mt-16">
        <div class="card border-loss/30 bg-loss/5">
          <p class="eyebrow text-loss">Drawdowns are part of the plan</p>
          <p class="mt-3 text-bone-dim">
            Expect a 30 to 40% drawdown at some point over 10 years. That's normal
            for this style, and it's exactly why it's the riskier of the two. If that
            would make you sell at the bottom, this isn't the one to learn on.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="container-wide py-14 md:py-24">
    <div class="card-interactive flex flex-col items-start gap-6 border-signal/30 p-12 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 class="font-display text-display-md uppercase tracking-tight">Want to learn the method?</h2>
        <p class="mt-3 text-bone-dim">
          <Pill color="red" /> is a written plan for your money and a 12 week
          path from budgeting to investing basics, with the library, a weekly
          lesson, and a community working through it with you.
        </p>
      </div>
      <a href="/membership" class="btn-primary whitespace-nowrap">
        See membership
      </a>
    </div>
  </section>

  <NewsletterCallout
    source="portfolios"
    eyebrow="LTM Investing Thesis · Free every Sunday"
    headline="Want to see how I think first?"
    description="Every Sunday I take one stock everyone's hyping and check the math. Free, about a five minute read, unsubscribe in one click."
  />

  <p class="container-wide pb-24 text-center text-xs text-bone-mute">
    Educational content only. Past performance does not indicate future results.
    Trading involves substantial risk of loss.
  </p>
</Layout>
