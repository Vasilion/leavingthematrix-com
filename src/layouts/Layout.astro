---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import MobileStickyCta from '../components/MobileStickyCta.astro';
import { SITE } from '../lib/site';
import Analytics from '../components/Analytics.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** "website" by default; set to "article" for blog posts. */
  ogType?: 'website' | 'article';
  /** Optional structured-data block to inject into <head>. JSON-LD object(s). */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Article-specific OG metadata, only used when ogType === 'article'. */
  article?: {
    publishedTime?: string;
    modifiedTime?: string;
    author?: string;
    section?: string;
    tags?: string[];
  };
}

const {
  title,
  description = SITE.description,
  image = '/og-default.png',
  noindex = false,
  ogType = 'website',
  jsonLd,
  article,
} = Astro.props;

const pageTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL(image, Astro.site).toString();
const twitterImage = new URL(image.replace('og-default.png', 'twitter-card.png'), Astro.site).toString();

// Default JSON-LD: Organization on every page.
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  legalName: SITE.legalName,
  founder: { '@type': 'Person', name: SITE.founder },
  url: Astro.site?.toString(),
  logo: new URL('/android-chrome-512x512.png', Astro.site).toString(),
  description: SITE.description,
  sameAs: [],
};

// On the home page, also add a WebSite block.
const isHome = Astro.url.pathname === '/';
const websiteLd = isHome
  ? {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: SITE.name,
      url: Astro.site?.toString(),
      description: SITE.description,
      publisher: { '@type': 'Organization', name: SITE.name },
    }
  : null;

const ldBlocks = [
  orgLd,
  ...(websiteLd ? [websiteLd] : []),
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <!-- Favicons -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#000000" />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta name="msapplication-TileImage" content="/android-chrome-192x192.png" />

    <!-- Canonical & robots -->
    <link rel="canonical" href={canonical} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    )}

    <!-- Primary meta -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.founder} />
    <meta name="publisher" content={SITE.legalName} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name} — ${SITE.tagline}`} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />

    {ogType === 'article' && article?.publishedTime && (
      <meta property="article:published_time" content={article.publishedTime} />
    )}
    {ogType === 'article' && article?.modifiedTime && (
      <meta property="article:modified_time" content={article.modifiedTime} />
    )}
    {ogType === 'article' && article?.author && (
      <meta property="article:author" content={article.author} />
    )}
    {ogType === 'article' && article?.section && (
      <meta property="article:section" content={article.section} />
    )}
    {ogType === 'article' && article?.tags?.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={twitterImage} />
    <meta name="twitter:image:alt" content={`${SITE.name} — ${SITE.tagline}`} />

    <!-- Discovery -->
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — Blog`} href="/rss.xml" />

    <!-- JSON-LD structured data -->
    {ldBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} is:inline />
    ))}

    <!-- Analytics (no-op unless PUBLIC_GA_ID is set) -->
    <Analytics />
  </head>
  <body class="flex min-h-screen flex-col bg-black text-bone">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-signal focus:px-4 focus:py-2 focus:text-sm focus:font-bold focus:text-black">
      Skip to main content
    </a>
    <Nav />
    <main id="main" class="flex-1 pb-20 md:pb-0">
      <slot />
    </main>
    <Footer />
    <ScrollToTop />
    <MobileStickyCta />
  </body>
</html>
